%2C315%2C331%2C356%2C246%2C235%2C69%2C236%2C234%2C359%2C350%2C59%2C247%2C120%2C144%2C91%2C134%2C61%2C133%2C139%2C138%2C65%2C73%2C71%2C166%2C87%2C88%2C128%2C44%2C39%2C60%2C63%2C113%2C180%2C1%2C137%2C16%2C135%2C12%2C2%2C64%2C104%2C15%2C74%2C70%2C131%2C100%2C99%2C185%2C186%2C105%2C106%2C9%2C115%2C184%2C58%2C157%2C98%2C90%2C80%2C130%2C119%2C167%2C50%2C158%2C0%2C93%2C151%2C155%2C168%2C45%2C121%2C13%2C187" async=""></script><script async="" src="https://connect.facebook.net/en_US/fbevents.js"></script><script type="text/javascript" async="" src="https://www.google-analytics.com/analytics.js"></script><script type="text/javascript" async="" src="https://cdn.taboola.com/libtrc/unip/1382618/tfa.js"></script><script type="text/javascript" async="" src="https://www.googletagmanager.com/gtag/js?id=G-K7B90B1WR0&amp;cx=c&amp;gtm=4e69n0"></script><script async="" src="https://www.googletagmanager.com/gtm.js?id=GTM-NXRLZVS"></script><script>!function(e,t,a,n,g){e[n]=e[n]||[],e[n].push({"gtm.start":(new Date).getTime(),event:"gtm.js"});var m=t.getElementsByTagName(a)[0],r=t.createElement(a);r.async=!0,r.src="https://www.googletagmanager.com/gtm.js?id=GTM-NXRLZVS",m.parentNode.insertBefore(r,m)}(window,document,"script","dataLayer")</script><meta name="robots" content="all"><noscript><meta http-equiv="refresh" content="0; url=/nojs/splash"></noscript><link rel="shortcut icon" type="image/x-icon" href="//schools-cdn.duolingo.com/favicon.ico"><link href="//schools-cdn.duolingo.com/vendor-aa60776a.css" rel="stylesheet"><link href="//schools-cdn.duolingo.com/app-9587fb63.css" rel="stylesheet">                         <script defer="defer" src="//schools-cdn.duolingo.com/js/manifest-640a1158.js"></script><script defer="defer" src="//schools-cdn.duolingo.com/js/css/ltr-5c44903d.js"></script><script defer="defer" src="//schools-cdn.duolingo.com/js/strings/en-a6c2b3d0.js"></script></head><body><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NXRLZVS" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><div id="root" onclick=""><div class="_32tsF"><div class="_2v6l4"><div class="_2_rVn"><img class="_2QgDM" src="//schools-cdn.duolingo.com/images/settings/e615abdbd73c1ae305859de63a0375cc.svg"><h2 class="_14ieI">Duolingo for Schools will be sunset on July 31, 2027. We’re grateful to the educators who have used and supported this program, and we’re committed to giving you time to plan and adjust.</h2><a class="_34v50 _275sd _1ZefG _3NF2U" href="javascript:;"><span class="dzcYz">Learn more</span><svg class="_3FnQy" fill="none" height="11" viewBox="0 0 7 11" width="7" xmlns="http://www.w3.org/2000/svg" style="height: 24px; transform: rotate(180deg); width: 24px;"><path d="M5.6001 1.40002L1.6001 5.40002L5.6001 9.40002" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1"></path></svg></a></div><div class="_3kYKU"></div><div class="_2Uud7"><nav class="_1MKRD"><img class="_3gZqb" src="//schools-cdn.duolingo.com/images/1ac662c38f6077cba917c6f394033e24.svg"><div class="lwZKA"><div class="_3c5zv"><a class="qj_jD" href="/professionaldev">Teacher Training</a><a class="qj_jD" href="https://duolingo.com">Duolingo</a></div><button class="_16h82 WOZnx _275sd _1ZefG _3GOA4 _1SJeU" data-test="splash-page-log-in"><span class="_13HXc">Login</span></button></div></nav></div><div class="_3g298"><section class="_2eZkQ _1Y0YZ"><div class="JCJoq"><div class="_2ij94"><h1 class="_3vANX _1wNbt">free for your classroom!</h1><p class="_2N-tw">An easy way to make language learning fun and personalized</p><button class="_2G7zH _3HhhB _2NolF _275sd _1ZefG _1oOyv _1pWdZ" data-test="splash-page-get-started"><span class="_13HXc">Sign Up</span></button></div><div class="g6GIr"><img src="//schools-cdn.duolingo.com/images/36f6de0980bf7fae7ff7a26d12076932.svg"></div></div></section></div><section class="_2eZkQ _15H8D"><section class="_31_-7"><div class="nR9Zi" tabindex="0"><div class="_2SSd5" style="transform: translateX(0px);"><div class="_1gD7O"><div><h1 class="_1F5tD">standards-aligned curriculum</h1><p class="_2RLF1">Duolingo for Schools applies both ACTFL and CEFR learning standards to Duolingo’s extensive curriculum, allowing you to find content that meets your teaching needs.</p><img alt="" class="_2sJNQ" draggable="false" src="//schools-cdn.duolingo.com/images/splash/4554d68c1e5f798620f380335bf7d0d4.svg"></div></div><div class="_1gD7O"><div><h1 class="_1F5tD">fun, personalized assignments</h1><p class="_2RLF1">Assignments leverage the best of AI and language science to adapt to the right level and pace for each student. And students love the game-like features and fun challenges!</p><img alt="" class="_2sJNQ" draggable="false" src="//schools-cdn.duolingo.com/images/splash/dd8ad0669c3388876d3fecd4407c2a55.svg"></div></div><div class="_1gD7O"><div><h1 class="_1F5tD">student progress insights</h1><p class="_2RLF1">See how your students are progressing with in-depth insights like accuracy and time spent learning.</p><img alt="" class="_2sJNQ" draggable="false" src="//schools-cdn.duolingo.com/images/splash/8e600ee309c20d2e4efa1964b52ec2f5.svg"></div></div></div></div><nav class="_3pNlw"><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_1yIdt _3k8-y -aP8Y _13HXc"></div></button><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_3k8-y -aP8Y _13HXc"></div></button><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_3k8-y -aP8Y _13HXc"></div></button></nav></section></section><section class="_2eZkQ _1-1Q3"><div class="_3Tzh3 _1FT7a"><img alt="Duolingo for Schools applies both ACTFL and CEFR learning standards to Duolingo’s extensive curriculum, allowing you to find content that meets your teaching needs." class="WO5E5" src="//schools-cdn.duolingo.com/images/splash/4554d68c1e5f798620f380335bf7d0d4.svg"><div class="_38wRM"><h2 class="_13MqT">standards-aligned curriculum</h2><p class="_1FQQA">Duolingo for Schools applies both ACTFL and CEFR learning standards to Duolingo’s extensive curriculum, allowing you to find content that meets your teaching needs.</p></div></div><div class="_34UFV _1FT7a"><img alt="Assignments leverage the best of AI and language science to adapt to the right level and pace for each student. And students love the game-like features and fun challenges!" class="WO5E5" src="//schools-cdn.duolingo.com/images/splash/dd8ad0669c3388876d3fecd4407c2a55.svg"><div class="_38wRM"><h2 class="_13MqT">fun, personalized assignments</h2><p class="_1FQQA">Assignments leverage the best of AI and language science to adapt to the right level and pace for each student. And students love the game-like features and fun challenges!</p></div></div><div class="_3Tzh3 _1FT7a"><img alt="See how your students are progressing with in-depth insights like accuracy and time spent learning." class="WO5E5" src="//schools-cdn.duolingo.com/images/splash/8e600ee309c20d2e4efa1964b52ec2f5.svg"><div class="_38wRM"><h2 class="_13MqT">student progress insights</h2><p class="_1FQQA">See how your students are progressing with in-depth insights like accuracy and time spent learning.</p></div></div></section><div class="_2t8kF"><section class="_3aHSW _2eZkQ"><h2 class="_2yzda _40Nx6">hear from our teachers</h2><section class="_31_-7"><div class="nR9Zi" tabindex="0"><div class="_2SSd5" style="transform: translateX(0px);"><div class="_1gD7O"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/b0b188089a2cb5d0359e6ec93f69f73d.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">Learning happens best when the application feels like a game. Duolingo is just plain fun, and we are able to leverage this in the classroom.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Pamela Parks</h4><p class="q3NcK">High School French, Spanish, &amp; Japanese teacher</p></div></div></div></div><div class="_1gD7O"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/c8176efe55f271f1874e5e239c2a686e.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">I love that Duolingo is a quick and easy way for my students to keep practicing their Spanish outside of the classroom.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Melissa Cantú</h4><p class="q3NcK">High School Spanish teacher</p></div></div></div></div><div class="_1gD7O"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/b2a7ea08f9ec09a4491ea3f471aec904.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">I love using Duolingo because the element of gamification makes my students forget that they are actually learning while playing.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Gitte Duus</h4><p class="q3NcK">High School language teacher</p></div></div></div></div></div></div><nav class="_3pNlw"><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_1yIdt _3k8-y _2nIj0 _13HXc"></div></button><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_3k8-y _2nIj0 _13HXc"></div></button><button class="_1H_R6 _1ZefG _25gW9" tabindex="-1"><div class="_3k8-y _2nIj0 _13HXc"></div></button></nav></section></section><section class="_2eZkQ Anbxh"><h2 class="_2yzda _40Nx6">hear from our teachers</h2><div class="_2bksu"><div class="Ve5f4"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/b0b188089a2cb5d0359e6ec93f69f73d.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">Learning happens best when the application feels like a game. Duolingo is just plain fun, and we are able to leverage this in the classroom.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Pamela Parks</h4><p class="q3NcK">High School French, Spanish, &amp; Japanese teacher</p></div></div></div></div><div class="Ve5f4"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/c8176efe55f271f1874e5e239c2a686e.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">I love that Duolingo is a quick and easy way for my students to keep practicing their Spanish outside of the classroom.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Melissa Cantú</h4><p class="q3NcK">High School Spanish teacher</p></div></div></div></div><div class="Ve5f4"><div class="_3agHf"><div class="_3ZW8w"><div class="_2-DQQ"><div class="_1XAPz"><img class="_28jy8" src="//schools-cdn.duolingo.com/images/splash/teachers/b2a7ea08f9ec09a4491ea3f471aec904.png"><img class="VKwnR" src="//schools-cdn.duolingo.com/images/splash/teachers/715431d94c9be726440306cde1f85962.svg"></div><p class="_2Iamr">I love using Duolingo because the element of gamification makes my students forget that they are actually learning while playing.</p></div><div class="_2-DQQ"><h4 class="rMeiW">Gitte Duus</h4><p class="q3NcK">High School language teacher</p></div></div></div></div></div></section></div><section class="_2eZkQ _3a-gk"><h2 class="_40Nx6">frequently asked questions</h2><div class="RmERj"><div class="_3K_4o"><p class="_1Clm9">Does Duolingo for Schools cost money?</p><p class="_22e5g">No! Duolingo for Schools is 100% free.</p></div><div class="_3K_4o"><p class="_1Clm9">Is Duolingo for Schools different from Duolingo?</p><p class="_22e5g">Duolingo for Schools is a free layer of management that sits on top of the Duolingo language learning app. You’ll gain visibility into and a level of control over your students’ experience on Duolingo.</p></div><div class="_3K_4o"><p class="_1Clm9">What if my students are already using Duolingo?</p><p class="_22e5g">We’ve got you covered! Add existing accounts to your classroom to preserve existing student progress, or get students started fresh with our quick account setup.</p></div></div></section><div class="_2jQ-y"><section class="_2eZkQ ABbC5"><h2 class="_2mijA _2yzda _40Nx6">a message for teachers</h2><p class="_3xdjD">A thank you from our CEO and co-founder.</p><div class="_16Aom"><div><iframe allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="" class="hc6f9" src="https://www.youtube.com/embed/E6hadnnW-JE?enablejsapi=1&amp;origin=https://schools.duolingo.com" data-gtm-yt-inspected-43402430_20="true" id="865658318" data-gtm-yt-inspected-29="true" title="Thank You Teachers"></iframe></div></div></section></div><section class="_2eZkQ _20kiJ"><img class="_1tXmt" src="//schools-cdn.duolingo.com/images/splash/91df9aca9db7e77f8e3fada5fd9da9fb.png"><div class="_2mjLz"><h1 class="Rz7yG _40Nx6">Bring Duolingo to your classroom</h1><button class="_3HhhB _2NolF _275sd _1ZefG nEfNp _2krKz"><span class="_13HXc">Get Started</span></button></div></section><footer class="Uuato"><ul class="_2f6CO"><li class="ht8T5"><a href="https://www.duolingo.com/">Duolingo</a></li><li class="ht8T5"><a href="https://www.duolingo.com/info">About</a></li><li class="ht8T5"><a href="https://careers.duolingo.com/">Careers</a></li><li class="ht8T5"><a href="https://www.duolingo.com/mobile">Apps</a></li><li class="ht8T5"><a href="https://duolingoschools.zendesk.com/hc/en-us">Help</a></li><li class="ht8T5"><a href="https://www.duolingo.com/terms">Terms</a></li><li class="ht8T5"><a href="https://www.duolingo.com/privacy">Privacy</a></li><li class="ht8T5"><a href="https://www.facebook.com/groups/duolingoeducators">Facebook</a></li><li class="ht8T5"><a href="https://twitter.com/DuolingoSchools">Twitter</a></li></ul></footer></div></div><div class="Toastify"></div></div><script>window.duo={"uiLanguage":"en"}</script><script>if(window.duo.cdn="//schools-cdn.duolingo.com",window.duo.version="5b4ef9c1993166948916ea57b3f8ba31cd0d86fd",window.duo.uiLanguage=window.duo.uiLanguage||"en","/errors/not-supported.html"!==window.location.pathname)for(var features=[],i=0;i<features.length;i++)features[i]||(window.location.href="/errors/not-supported.html")</script><script defer="defer" src="//schools-cdn.duolingo.com/js/vendor-5894e16b.js"></script><script defer="defer" src="//schools-cdn.duolingo.com/js/app-60f1f59e.js"></script><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div><div class="ReactModalPortal"></div>
