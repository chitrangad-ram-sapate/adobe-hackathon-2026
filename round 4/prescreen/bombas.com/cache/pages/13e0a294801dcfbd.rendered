,{\"property\":\"og:image:secure_url\",\"content\":\"https://assets.bombas.com/image/fetch/c_scale,f_auto,q_auto/https://images.ctfassets.net/09hbx69ra4p2/6BkDMtYCo0oxrgeSWKLufH/97bd5fc90b8c7b4cd5f59bd8c2f3dbbe/gift-card-transparent.png\"}]],[\"$\",\"meta\",\"og:image:width\",{\"property\":\"og:image:width\",\"content\":\"4000\"}],[\"$\",\"meta\",\"og:image:height\",{\"property\":\"og:image:height\",\"content\":\"4000\"}]]]\n2d:T193c,\u003cdiv id=\"yotpo-reviews-section-data\" style=\"margin-top:4px; font-size:11px; line-height:1.35; color:#555; max-height:220px; overflow:auto; padding:6px 8px; border:1px solid #eee; border-radius:4px; background:#fafafa;\"\u003e\n  \u003csection id=\"yotpo-reviews-overall-rating\"\u003e\n    \u003cp\u003e\u003cstrong\u003eOverall rating:\u003c/strong\u003e 4.891892 / 5 from 37 reviews.\u003c/p\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-ai-summary\"\u003e\n    \u003ch3\u003eAI Generated Review Summary\u003c/h3\u003e\n    \u003cp\u003e\u003c/p\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-summary-topics\"\u003e\n    \u003ch3\u003eSummary topics\u003c/h3\u003e\n    \u003cul\u003e\n      \n    \u003c/ul\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-review-topics\"\u003e\n    \u003cp\u003e\u003cstrong\u003eReview topics:\u003c/strong\u003e [\u0026quot;fit\u0026quot;,\u0026quot;quality\u0026quot;,\u0026quot;gift\u0026quot;,\u0026quot;socks\u0026quot;,\u0026quot;bombas\u0026quot;,\u0026quot;received\u0026quot;,\u0026quot;slippers\u0026quot;,\u0026quot;wear\u0026quot;,\u0026quot;order\u0026quot;].\u003c/p\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-highlights\"\u003e\n    \u003ch3\u003eReview highlights\u003c/h3\u003e\n    \u003cul\u003e\n      \n    \u003c/ul\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-individual-reviews\"\u003e\n    \u003ch3\u003eReviews\u003c/h3\u003e\n    \u003carticle class=\"yotpo-review\" data-reviewer=\"Stanley R.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eA Bombas gift card is\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;A Bombas gift card is a life saver when you're stuck trying to decide on the perfect solution to an all-too-common dilemma! The reaction I received was over the top, as the recipient had no idea about your business model of giving the same great product to someone in need. Thank you, Bombas!! (Ps You now have another loyal customer :)\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eStanley R.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Zachary C.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eAwesome!! Thank you!!\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Arise gift for my Dad!! He loves them!! Thank you so much!!\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eZachary C.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Margaret O.\" data-rating=\"2\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eA gift card\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Bombas asked me to review my recent purchase of a gift card. The gift card was delivered to my friend who I wanted to give a gift to. She likes Bombas. She thanked me for the gift. So I guess this was a good purchase. One star off because this is a ridiculous thing to ask people to review on your website.\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eMargaret O.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e2/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Sharon M.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eDigital gift card arrived on date requested.\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;My challenging to shop for daughter picked out some slippers that she is very happy with and I supported a conscientious company☘\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eSharon M.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Brenda K.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eGift card was appreciated by\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Gift card was appreciated by recipients.\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eBrenda K.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Carolyn M.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eGreat Gift to Give.\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Bought for my Son\u0026rsquo;s birthday. He loved picking out his own socks!\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eCarolyn M.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"todd g.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eThe Most Comfortable Compression Socks, Ever!\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;I can't stand socks that cover my shins. They make my skin itchy to the point of scratching myself raw. Thanks to Bombas, I found the perfect ankle socks, and the amount compression is just right. I wear these all day, every day. They're the most comfortable socks I've ever worn. They look cool, too!\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003etodd g.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Lorraine G.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eFabulous\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Perfect gift. She wanted socks \u0026amp; was able to select her hearts desire.\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eLorraine G.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Betsy W.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eEasy Holiday Shopping\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;Great way to send a gift to someone on the other side of the country with no annoying mailing of packages. Our friend was delighted to get the gift card on-line. New to Bombas but heard us rave about the socks. Now she can choose from the was variety of products!\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eBetsy W.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\u003carticle class=\"yotpo-review\" data-reviewer=\"Barbara P.\" data-rating=\"5\"\u003e\n      \u003ch4 class=\"yotpo-review-title\"\u003eLove my Bombas!\u003c/h4\u003e\n      \u003cp class=\"yotpo-review-body\"\u003e\u0026quot;I ordered Bombas socks for my husband and myself for Christmas. I also sent gift cards to my daughters and a friend. Everyone is enjoying happy feet! Your donation to people in need is an added bonus.\u0026quot;\u003c/p\u003e\n      \u003cp class=\"yotpo-review-author\"\u003e\u0026mdash; \u003cspan class=\"yotpo-reviewer-name\"\u003eBarbara P.\u003c/span\u003e (\u003cspan class=\"yotpo-review-rating\"\u003e5/5\u003c/span\u003e)\u003c/p\u003e\n    \u003c/article\u003e\n  \u003c/section\u003e\n  \u003csection id=\"yotpo-reviews-qa\"\u003e\n    \u003ch3\u003eQ\u0026amp;A\u003c/h3\u003e\n    \u003cdl\u003e\n      \n    \u003c/dl\u003e\n  \u003c/section\u003e\n\u003c/div\u003e2c:[\"$\",\"div\",null,{\"className\":\"visually-hidden\",\"data-label\":\"yotpo-llm-schema\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2d\"}}]\n"])</script><script>self.__next_f.push([1,"2e:I[461210,[\"/_next/static/immutable/chunks/1095tjajrojwn.js\",\"/_next/static/immutable/chunks/191axlpy5_e2d.js\",\"/_next/static/immutable/chunks/0bbw893gjr3b8.js\",\"/_next/static/immutable/chunks/0tlmyyb8sy9a-.js\",\"/_next/static/immutable/chunks/42rd_rcqjwtl9.js\",\"/_next/static/immutable/chunks/2f23-nqijvlnm.js\",\"/_next/static/immutable/chunks/3038wkq1_9hyh.js\",\"/_next/static/immutable/chunks/0mt15xn0k1tat.js\",\"/_next/static/immutable/chunks/3667mxmrcda4r.js\",\"/_next/static/immutable/chunks/29z51w_g6ucl-.js\",\"/_next/static/immutable/chunks/2yyvcessj4igf.js\",\"/_next/static/immutable/chunks/2sse4ucmq7vpx.js\",\"/_next/static/immutable/chunks/0ppnyhui_3n92.js\",\"/_next/static/immutable/chunks/2c5z3ljr-lpwo.js\",\"/_next/static/immutab