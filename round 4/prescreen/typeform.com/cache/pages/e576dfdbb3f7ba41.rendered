<!-- JS Tracking imports -->
<script>
    (function loadJsTracking() {
        var version = window.isStaging
            ? "22.49.0"
            : "22.49.0";

        [
            "attributionUtil.js",
            "consentUtil.js",
            "trackingClient.js",
            "cookiesUtil.js",
        ].forEach(function (file) {
            document.write(
                '<script src="https://public-assets.typeform.com/public/js-tracking/' +
                    version +
                    "/" +
                    file +
                    '"><\/script>',
            );
        });
    })();
