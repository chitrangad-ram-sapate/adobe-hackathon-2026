  :.pricing-plans_includes-wrap:-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }
  
  /* For Firefox */
  .pricing-plans_includes-wrap {
    scrollbar-color: var(--_colour-primitives---primitives--neutral--400) transparent;
    scrollbar-width: thin;
  }

  
  
</style></div><div class="cc_pricing-sticky w-embed w-script"><script>
  (function() {
    const debug = true;

    const debugLog = (message) => {
      if (debug) {
        console.log(message);
      }
    };

    document.addEventListener("DOMContentLoaded", function() {
      const elements = {
        wrapper: document.querySelector('[data-pricebar="wrapper"]'),
        stickyElement: document.querySelector('[data-pricebar="sticky"]'),
        stickyBgElement: document.querySelector('[data-pricebar="sticky"] [data-pricebar="sticky-background"]'),
        planWrapper: document.querySelector('[data-planbar="sticky-wrapper"]'),
        planStickyElement: document.querySelector('[data-planbar="sticky"]'),
        planStickyBgElement: document.querySelector('[data-planbar="sticky"] [data-planbar="sticky-background"]'),
        subplanWrapper: document.querySelector('[data-subplanbar="sticky-wrapper"]'),
        subplanStickyElement: document.querySelector('[data-subplanbar="sticky"]'),
        subplanStickyBgElement: document.querySelector('[data-subplanbar="sticky"] [data-subplanbar="sticky-background"]')
      };

      Object.entries(elements).forEach(([name, el]) => {
        debugLog(el ? "Found: " + name : "Missing: " + name);
      });

      const activeClass = elements.stickyElement
        ? (elements.stickyElement.dataset.activeclass || "is-active")
        : "is-active";
      debugLog("Active class is: " + activeClass);

      gsap.registerPlugin(ScrollTrigger);

      if (elements.wrapper && elements.stickyElement && elements.stickyBgElement) {
        ScrollTrigger.create({
          trigger: elements.wrapper,
          start: "top -10%",
          end: "bottom bottom",
          onEnter: () => {
            debugLog("Wrapper reached the top of the viewport. Adding active class.");
            elements.stickyElement.classList.add(activeClass);
            elements.stickyBgElement.classList.add(activeClass);
          },
          onLeaveBack: () => {
            debugLog("Wrapper left the top of the viewport. Removing active class.");
            elements.stickyElement.classList.remove(activeClass);
          }
        });

        ScrollTrigger.create({
          trigger: elements.wrapper,
          start: "top -10%",
          end: "bottom bottom",
          onEnter: () => {
            debugLog("Wrapper reached the top of the viewport. Adding background active class.");
            elements.stickyBgElement.classList.add(activeClass);
          },
          onLeaveBack: () => {
            debugLog("Wrapper left the top of the viewport. Removing background active class.");
            elements.stickyBgElement.classList.remove(activeClass);
          },
          onLeave: () => {
            debugLog("Wrapper reached the bottom of the viewport. Removing background active class.");
            elements.stickyBgElement.classList.remove(activeClass);
          },
          onEnterBack: () => {
            debugLog("Wrapper re-entered the viewport from the bottom. Adding background active class.");
            elements.stickyBgElement.classList.add(activeClass);
          }
        });
      } else {
        debugLog("Pricebar elements missing. Skipping pricebar ScrollTriggers.");
      }

      if (elements.planWrapper && elements.planStickyElement && elements.planStickyBgElement) {
        const planStickyTopValue = parseInt(elements.planStickyElement.dataset.positiontop, 10) || 0;
        ScrollTrigger.create({
          trigger: elements.planWrapper,
          start: "top " + (-planStickyTopValue) + "px",
          end: "bottom bottom",
          onEnter: () => {
            debugLog("PlanWrapper reached the top of the viewport minus sticky top value. Adding active class.");
            elements.planStickyElement.classList.add(activeClass);
            elements.planStickyBgElement.classList.add(activeClass);
          },
          onLeaveBack: () => {
            debugLog("PlanWrapper left the top of the viewport. Removing active class.");
            elements.planStickyElement.classList.remove(activeClass);
            elements.planStickyBgElement.classList.remove(activeClass);
          }
        });
      } else {
        debugLog("Plan elements missing. Skipping plan ScrollTriggers.");
      }

      if (elements.subplanWrapper && elements.subplanStickyElement && elements.subplanStickyBgElement) {
        const subplanStickyTopValue = (parseInt(elements.subplanStickyElement.dataset.positiontop, 10) || 0) + 48;
        ScrollTrigger.create({
          trigger: elements.subplanWrapper,
          start: "top " + (-subplanStickyTopValue) + "px",
          end: "bottom bottom",
          onEnter: () => {
            debugLog("SubplanWrapper reached the top of the viewport minus sticky top value. Adding active class.");
            elements.subplanStickyElement.classList.add(activeClass);
            elements.subplanStickyBgElement.classList.add(activeClass);
          },
          onLeaveBack: () => {
            debugLog("SubplanWrapper left the top of the viewport. Removing active class.");
            elements.subplanStickyElement.classList.remove(activeClass);
            elements.subplanStickyBgElement.classList.remove(activeClass);
          }
        });
      } else {
        debugLog("Subplan elements missing. Skipping subplan ScrollTriggers.");
      }
    });
  })();
</script></div><div class="cc_pricing-tooltip w-embed w-script"><script>
  (function (window) {
    if (typeof window.initializeTooltips !== 'function') {
      // Track the actual tooltip elements that have been interacted with
      const trackedTooltipElements = new WeakSet();

      window.initializeTooltips = function () {
        const elements = document.querySelectorAll('[data-tooltip="instance"]');            

        elements.forEach((element) => {
          if (!element._tippy) {
            const contentDiv = element.querySelector('div[data-tooltip="content"]');

            if (contentDiv) {
              tippy(element, {
                content: contentDiv.innerHTML,
                allowHTML: true,
                interactive: true,
                onShow(instance) {
                  // Only track if we haven't tracked this specific tooltip element before
                  if (!trackedTooltipElements.has(instance.reference)) {
                    let label;
                    let location;

                    const pricingPlansCard = instance.reference.closest('.pricing-plans_card');
                    const pricingTableRow = instance.reference.closest('.pricing-compare_table-row-wrap');

                    if (pricingPlansCard) {
                      const parentChecklistItem = instance.reference.closest('.checklist-item');
                      label = parentChecklistItem?.getAttribute('cc-t-pricing_plans_feature_label');
                      location = 'body:compare_plans';
                    } else if (pricingTableRow) {
                      label = pricingTableRow.getAttribute('cc-t-pricing_feature_label');
                      location = 'grid:plan_features';

                      // Check if snake case is disabled for this row
                      const shouldSnakeCase = pricingTableRow.getAttribute('cc-t-utility-snake_case')?.toLowerCase() !== 'off';
                      if (!shouldSnakeCase) {
                        // Use label as-is without snake casing
                        trackedTooltipElements.add(instance.reference);

                        window.trackingHelper.trackItemClicked({
                          item: 'tooltip_features',
                          item_type: 'hover',
                          label: label, // Use label directly without snake casing
                          location: location
                        });
                        return; // Exit early to avoid duplicate tracking
                      }
                    }

                    // Add this tooltip element to our tracked set
                    trackedTooltipElements.add(instance.reference);

                    window.trackingHelper.trackItemClicked({
                      item: 'tooltip_features',
                      item_type: 'hover',
                      label: window.trackingHelper.snakeCase(label),
                      location: location
                    });
                  }
                }
              });
            }
          }
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.initializeTooltips);
      } else {
        window.initializeTooltips();
      }
    }
  })(window);
</script></div><div class="js-script w-embed w-script"><script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('hr-pricing');

    // Inject styles dynamically
    const style = document.createElement('style');
    style.textContent = `
    #hr-pricing {
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease, display 0.3s allow-discrete;
    }

    #hr-pricing.is-active {
      display: flex;
      opacity: 1;
    }

    @starting-style {
      #hr-pricing.is-active {
        opacity: 0;
      }
    }
  `;
    document.head.appendChild(style);

    const closeModal = () => {
      modal.classList.remove('is-active');
      document.body.style.overflow = '';
    };

    const openModal = () => {
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    };

    document.getElementById('talent-pricing').addEventListener('click', openModal);

    document.getElementById('pricing-modal-close').addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  });
</script></div><div class="cc_t-pricing code w-embed w-script"><script>
document.addEventListener('DOMContentLoaded', () => {

    // Enrich t events with extra data
    const observer = new MutationObserver((mutationsList, observer) => {
      if (window.analytics) {
        window.analytics.ready(() => {
          window.trackingHelper.setPageTrackingProps({pricing_version:`3.1`});
        });
        observer.disconnect();
      }
    });

    // Start observing the document for changes
    observer.observe(document, { childList: true, subtree: true });
    // Select all accordion wrap elements
    const accordionWraps = document.querySelectorAll('.faq-accordion_wrap');
    // Add click listeners to each accordion's button
    if (accordionWraps.length) {
      accordionWraps.forEach((accordion, index) => {
        const button = accordion.querySelector('button');
        const questionHeader = accordion.querySelector('h3');

        if (button && questionHeader) {
          button.addEventListener('click', function() {
            // Check if the accordion is currently closed (meaning this click will open it)
            if (this.getAttribute('aria-expanded') === 'false') {
              const questionText = questionHeader.textContent.trim();
              const numberedName = `${index + 1}_${questionText}`;

              window.trackingHelper.trackItemClicked({
                item: 'basic_faq',
                label: window.trackingHelper.snakeCase(numberedName), // Using the numbered name in snake case
                location: 'template_body'
              });           
            }
          });
        }
      });
    }

    // Track links within accordions
    const linksInAccordions = document.querySelectorAll('.faq-accordion_wrap a');
    if (linksInAccordions.length) {
      linksInAccordions.forEach(link => {
        link.addEventListener('click', function() {
          window.trackingHelper.trackItemClicked({
            item: 'redirect_to_page',  
            item_type: 'link',
            label: window.trackingHelper.snakeCase(this.textContent.trim()),
            link_url: link.href,
            location: 'basic_faq'
          });
        });
      });
    }

    // Track links from feature rows
    const pricingFeatureTableLinks = document.querySelectorAll('a[cc-t-id="pricing-feature"]');
    if (pricingFeatureTableLinks.length) {
      pricingFeatureTableLinks.forEach(link => {
        link.addEventListener('click', function() {
          // Find the parent element with the pricing-compare_table-row-wrap class
          const parentRow = this.closest('.pricing-compare_table-row-wrap');
          // Get the label directly from the parent's attribute
          const pricingFeatureLabel = parentRow.getAttribute('cc-t-pricing_feature_label');

          // Check if snake case is disabled for this row
          const shouldSnakeCase = parentRow.getAttribute('cc-t-utility-snake_case')?.toLowerCase() !== 'off';

          window.trackingHelper.trackItemClicked({
            item: 'redirect_to_page',  
            item_type: 'link',
            label: shouldSnakeCase ? window.trackingHelper.snakeCase(pricingFeatureLabel) : pricingFeatureLabel,
            link_url: link.href,
            location: 'grid:plan_features'
          });
        });
      });
    }

    // Track all pricing grid signup buttons including enterprise
    const planSelectorButtons = document.querySelectorAll('[cc-t-id="signup-button-wrap-grid"] > a, #get-enterprise-button_grid-features');
    planSelectorButtons.forEach((linkElement) => {
      // Set skip attribute for enterprise button
      if (linkElement.id === 'get-enterprise-button_grid-features') {
        linkElement.setAttribute('cc-global-skip', 'self');
      }

      linkElement.addEventListener('click', () => {
        window.trackingHelper.trackItemClicked({
          item: linkElement.id === 'get-enterprise-button_grid-features' ? 'contact_sales' : 'plan_selector',
          item_type: 'button',
          location: 'grid:plan_features',
          link_url: linkElement.href,
          plan_name: linkElement.parentElement?.getAttribute('data-pricing-plan-name'),
          plan_code: linkElement.parentElement?.getAttribute('data-pricing-plan-name')
        });
      });
    });
    
    // Track all add-ons available CTA elements
  const addonsElements = document.querySelectorAll('[cc-t-id="compare_addons"] a');
  
  addonsElements.forEach((linkElement) => {
    linkElement.addEventListener('click', () => {
      // Find the pricing card parent to get plan information
      const pricingCard = linkElement.closest('[data-pricing-card="true"]');

      // Find the compare_addons wrapper and extract the text
      const addonsWrapper = linkElement.closest('[cc-t-id="compare_addons"]');
      const labelText = addonsWrapper?.textContent.trim() || 'compare_addons';

      // Get the tracking data object
      const trackingData = {
        item: 'compare_addons',
        item_type: 'button',
        label: window.trackingHelper.snakeCase(labelText),
        location: 'body:compare_plans',
        plan_name: pricingCard?.getAttribute('data-pricing-plan-name'),
        plan_code: pricingCard?.getAttribute('data-pricing-plan-name')
      };

      // Use the existing trackingHelper
      if (window.trackingHelper && typeof window.trackingHelper.trackItemClicked === 'function') {
        window.trackingHelper.trackItemClicked(trackingData);
      } else {
        console.warn('Tracking helper not properly initialized');
      }
    });
  });
  
  // Track all learn more links for contacts and automations add-on elements
  const contactsAndAutomationsLearnMore = document.querySelectorAll('[cc-t-id="contacts_and_automations_learn_more"] a');
  
  contactsAndAutomationsLearnMore.forEach((linkElement) => {
    linkElement.addEventListener('click', () => {
      
      // Get the tracking data object
      const trackingData = {
        item: 'redirect_to_page',
        item_type: 'button',
        label: 'contacts_and_automations',
        location: 'body:addons',
        link_url: linkElement.href
      };
      
      // Use the existing trackingHelper
      if (window.trackingHelper && typeof window.trackingHelper.trackItemClicked === 'function') {
        window.trackingHelper.trackItemClicked(trackingData);
      } else {
        console.warn('Tracking helper not properly initialized');
      }
    });
  });
  
  // Track all Get Addon buttons
  const getAddonButtons = document.querySelectorAll('[cc-t-id="get_addon"] a');

  getAddonButtons.forEach((linkElement) => {
    linkElement.addEventListener('click', () => {
      // Get the parent element with cc-t-label attribute
      const parentElement = linkElement.parentElement;
      const label = parentElement?.getAttribute('cc-t-label');

      // Get the tracking data object
      const trackingData = {
        item: 'addon_selector',
        item_type: 'button',
        label: label,
        location: 'body:addons',
        link_url: linkElement.href
      };

      // Use the existing trackingHelper
      if (window.trackingHelper && typeof window.trackingHelper.trackItemClicked === 'function') {
        window.trackingHelper.trackItemClicked(trackingData);
      } else {
        console.warn('Tracking helper not properly initialized');
      }
    });
  });
  
  // Track C&A Contact Sales button
  const contactSalesAddonButtons = document.querySelectorAll('[cc-t-id="contacts_and_automations_contact_sales"] a');

  contactSalesAddonButtons.forEach((linkElement) => {
    linkElement.addEventListener('click', () => {

      // Get the tracking data object
      const trackingData = {
        item: 'contact_sales',
        item_type: 'button',
        label: 'contacts_and_automations_custom',
        location: 'body:addons',
        link_url: linkElement.href
      };

      // Use the existing trackingHelper
      if (window.trackingHelper && typeof window.trackingHelper.trackItemClicked === 'function') {
        window.trackingHelper.trackItemClicked(trackingData);
      } else {
        console.warn('Tracking helper not properly initialized');
      }
    });
  });

});
</script></div><div class="cc_pricing-select w-embed w-script"><!-- Select Plans -->
<script>
/**
 * @file Custom Select Plan Interaction Script
 * @description
 * Adds custom interactivity for select dropdowns and clickable plan selectors using Finsweet's `selectcustom` attribute.
 * It keeps the selected value in sync with the toggle button and allows closing or resetting selections.
 *
 * ## How It Works:
 * - Runs when Finsweet’s `selectcustom` attribute is initialized.
 * - Finds all containers with `[data-pricing-select-instance]`.
 * - Each container includes:
 *   - Toggle button → `[data-pricing-select="toggle"]`
 *   - Option links → `<a>`
 *   - Optional close buttons → `[data-pricing-select="close"]`
 * - When an option is clicked, updates the toggle’s `data-pricing-selectcurrent` attribute.
 * - When a close button is clicked, re-triggers the currently active option.
 *
 * ## Debugging:
 * - Set `debug = true` at the top to see detailed console logs.
 * - Logs show instance numbers, found options, selected values, and button interactions.
 *
 * ## Example Structure:
 * ```html
 * <div data-pricing-select-instance>
 *   <button data-pricing-select="toggle" data-pricing-selectcurrent=""></button>
 *   <div>
 *     <a>Basic</a>
 *     <a>Plus</a>
 *     <a>Business</a>
 *   </div>
 *   <button data-pricing-select="close">Close</button>
 * </div>
 * ```
 *
 * ## Notes:
 * - Works seamlessly with multiple select instances on the same page.
 * - Ensures the toggle button always reflects the last chosen option.
 * - Uses native Finsweet attribute initialization (`fsAttributes.push(['selectcustom', ...])`).
 * - Safe for use within Webflow custom embeds.
 */

  window.fsAttributes = window.fsAttributes || []
  window.fsAttributes.push([
    'selectcustom',
    function () {
      ;(function () {
        // Debug flag to control console logging
        const debug = false

        // Debug log function
        function debugLog(message, ...optionalParams) {
          if (debug) {
            console.log('💠', message, ...optionalParams)
          }
        }

        // Select all instances
        const instances = document.querySelectorAll(
          '[data-pricing-select-instance]'
        )
        debugLog('Number of instances found:', instances.length)

        // Iterate through each instance
        instances.forEach((instance, index) => {
          debugLog(`Processing instance ${index + 1}`)

          // Get all options ("a" tags) and <option> tags within the instance
          const options = instance.querySelectorAll('a')
          const selectOptions = instance.querySelectorAll('option')
          debugLog(
            `All options in instance ${index + 1} (a tags):`,
            options
          )
          debugLog(
            `All <option> elements in instance ${index + 1}:`,
            selectOptions
          )

          // Store the value attribute of each <option> element
          let selectOptionValues = Array.from(selectOptions).map(
            (selectOption) => selectOption.getAttribute('value')
          )
          debugLog(
            `Select option values for instance ${index + 1}:`,
            selectOptionValues
          )

          const toggleButton = instance.querySelector(
            '[data-pricing-select="toggle"]'
          )
          if (!toggleButton) {
            debugLog(`No toggle button found in instance ${index + 1}`)
            return
          }

          debugLog(`Toggle button found in instance ${index + 1}`)

          // Set initial value for data-pricing-selectcurrent if empty
          if (
            !toggleButton.getAttribute('data-pricing-selectcurrent') &&
            selectOptionValues.length > 0
          ) {
            const initialValue = `${selectOptionValues[0]}`
            toggleButton.setAttribute(
              'data-pricing-selectcurrent',
              initialValue
            )
            debugLog(
              `Initial data-pricing-selectcurrent set to: ${initialValue}`
            )
          }

          // Add event listener to each option
          options.forEach((option, optionIndex) => {
            option.addEventListener('click', () => {
              const optionValue =
                    selectOptionValues[optionIndex] ||
                    option.textContent.trim().toLowerCase()
              debugLog(
                `Option ${optionIndex + 1} clicked in instance ${
                index + 1
                } with value: ${optionValue}`
              )

              // Update the toggle button's attribute with the new value from selectOptionValues based on index
              toggleButton.setAttribute(
                'data-pricing-selectcurrent',
                optionValue
              )
              debugLog(
                `Updated toggle button's data-pricing-selectcurrent attribute with value: ${optionValue}`
              )
            })
          })

          // Add event listener to each close button
          const closeButtons = instance.querySelectorAll(
            '[data-pricing-select="close"]'
          )
          closeButtons.forEach((closeButton, buttonIndex) => {
            closeButton.addEventListener('click', () => {
              const currentButton =
                    instance.querySelector('a.w--current')
              if (currentButton) {
                currentButton.click()
                debugLog(
                  `Close button ${
                  buttonIndex + 1
                  } clicked in instance ${
                  index + 1
                  }, triggered current button click`
                )
              }
            })
          })
        })
      })()
    },
  ])

</script></div></div><main id="content" tabindex="-1" class="main"><div id="hr-pricing" role="dialog" aria-modal="true" aria-labelledby="Talent-pricing-plan" class="hr-pricing_popover_component"><div data-pricing-card="true" class="pricing-plans_card-modal is-talent"><div class="pricing-plans_title-left"><div class="pricing-plans_card-title">Talent</div><div class="text-size-regular text-color-secondary">Improve employee experience with best-in-class Al, video, and automation</div></div><div class="w-layout-vflex pricing-plans_card-content-wrap"><div data-pricing-taboption="monthly" class="w-layout-vflex pricing-plans_card-price-wrap is-left"><div class="pricing-plans_card-price"><div data-pricing-plan="talent" data-pricing-id="monthly-total">169</div><div>&nbsp;</div><div data-pricing-id="currency">USD</div><div class="pricing-plans_card-price-span">/</div><div class="pricing-plans_card-price-span">mo</div></div><div class="pricing-plans_card-save is-total"><div data-pricing-plan="talent" data-pricing-id="monthly-annual-total">2,028</div><div>&nbsp;</div><div data-pricing-id="currency">USD</div><div>&nbsp;</div><div>total</div><div>&nbsp;</div><div>/</div><div>yr</div></div></div><div data-pricing-taboption="yearly" class="w-layout-vflex pricing-plans_card-price-wrap is-left"><div class="pricing-plans_card-price"><div data-pricing-plan="talent" data-pricing-id="yearly-total">119</div><div>&nbsp;</div><div data-pricing-id="currency">USD</div><div class="pricing-plans_card-price-span">/</div><div class="pricing-plans_card-price-span">mo</div></div><div class="pricing-plans_card-save"><div>Save</div><div>&nbsp;</div><div data-pricing-id="yearly-saving" data-pricing-plan="talent">600</div><div>&nbsp;</div><div data-pricing-id="currency">USD</div><div>&nbsp;</div><div>/</div><div>yr</div></div></div></div><div class="pricing-plans_includes-outer"><div class="pricing-plans_includes-wrap"><div class="hr-pricing_scroll"><div class="w-layout-vflex pricing-plans_list"><div c