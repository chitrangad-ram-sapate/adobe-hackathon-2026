<!-- OpenGraph Meta Tag: og:url -->
<script defer="">
    (function () {
        const baseUrl = window.location.href.split("?")[0];
        const ogUrl = window.location.search.includes("page=")
            ? `${baseUrl}${window.location.search}`
            : baseUrl;
        let metaTag =
            document.querySelector('meta[property="og:url"]') ||
            document.createElement("meta");

        metaTag.setAttribute("property", "og:url");
        metaTag.setAttribute("content", ogUrl);

        if (!document.head.contains(metaTag)) {
            const ref = document.querySelector('meta[name="description"]');
            ref ? ref.after(metaTag) : document.head.appendChild(metaTag);
        }
    })();
</script>
<!-- End OpenGraph Meta Tag: og:url -->

<!-- Optimizely x OneTrust bootstrap starts -->
<script>
    (function optimizelyOneTrustBootstrap() {
        if (window.isStaging) {
            return;
        }

        var OPTIMIZELY_SRC =
            "https://cdn.optimizely.com/js/6084697625722880.js";
        var ANALYTICS_GROUP_IDS = ["2", "C0002"];

        var optimizelyLoaded = false;
        var optimizelyOptedOut = false;

        function getActiveGroups(event) {
            // OneTrust's native OneTrustGroupsUpdated event exposes the active
            // categories in event.detail. Fall back to OnetrustActiveGroups so
            // the legacy synthetic event in the footer remains harmless.
            if (event && Array.isArray(event.detail)) {
                return event.detail.map(String);
            }

            return String(window.OnetrustActiveGroups || "")
                .split(",")
                .map(function (group) {
                    return group.trim();
                })
                .filter(Boolean);
        }

        function hasAnalyticsConsent(event) {
            var activeGroups = getActiveGroups(event);

            return ANALYTICS_GROUP_IDS.some(function (groupId) {
                return activeGroups.indexOf(groupId) !== -1;
            });
        }

        function loadOptimizely() {
            if (optimizelyLoaded || optimizelyOptedOut) {
                return;
            }

            optimizelyLoaded = true;
            window.optimizely = window.optimizely || [];

            var script = document.createElement("script");
            script.src = OPTIMIZELY_SRC;
            script.async = false;
            script.onerror = function () {
                // Allow a later OneTrustGroupsUpdated event/navigation state
                // to retry if the network request itself failed.
                optimizelyLoaded = false;
            };

            document.head.appendChild(script);
        }

        function optOutOfOptimizely() {
            // If Optimizely has never loaded there is nothing to disable: the
            // consent gate is simply the absence of the snippet.
            if (!optimizelyLoaded || optimizelyOptedOut) {
                return;
            }

            optimizelyOptedOut = true;
            window.optimizely = window.optimizely || [];
            window.optimizely.push({
                type: "optOut",
                isOptOut: true,
            });
        }

        function handleOneTrustGroupsUpdated(event) {
            if (hasAnalyticsConsent(event)) {
                // Initial US opt-out decision: Analytics is active by default,
                // so Optimizely starts as soon as OneTrust publishes its state.
                // In opt-in regions this also allows Optimizely to start on the
                // same page if the visitor later grants Analytics consent.
                loadOptimizely();
            } else {
                // If consent is absent on initial load, Optimizely has not been
                // requested. If consent is later revoked after it has loaded,
                // stop Optimizely for the remainder of this pageview.
                optOutOfOptimizely();
            }
        }

        // Register before loading OneTrust so the initial consent decision
        // cannot be missed on a cold page load.
        window.addEventListener(
            "OneTrustGroupsUpdated",
            handleOneTrustGroupsUpdated,
        );
    })();
</script>
<!-- Optimizely x OneTrust bootstrap ends -->

