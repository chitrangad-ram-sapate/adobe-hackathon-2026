/div><p class="slide_social-title u-font-serif">Viva scaled talent acquisition and cut time to hire by 75%</p></div><div class="h2-bg-shine"><img src="https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine.avif" loading="lazy" sizes="100vw" srcset="https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine-p-500.png 500w, https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine-p-800.png 800w, https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine.avif 1314w" alt=""></div><div class="h2-bg-shine is-2"><img src="https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine.avif" loading="lazy" sizes="100vw" srcset="https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine-p-500.png 500w, https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine-p-800.png 800w, https://cdn.prod.website-files.com/66ffe2174aa8e8d5661c2708/69fdaa09a6268fabbe841f8e_27e784d2035076a6dcab738148a0daa2_bg-shine.avif 1314w" alt="" class="h2-slide_social-proof_shine"></div></div></div></div><span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div><div class="swiper-bottom"><div class="swiper-bullet-wrapper cc-social-proof swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal"><span class="swiper-bullet is-active" tabindex="0" role="button" aria-label="Go to slide 1" aria-current="true"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 2"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 3"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 4"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 5"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 6"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 7"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 8"></span><span class="swiper-bullet" tabindex="0" role="button" aria-label="Go to slide 9"></span></div></div></div></div><div class="u-embed-js w-embed w-script"><!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof Swiper === "undefined") {
      console.error("Swiper library not loaded");
      return;
    }

    const isDesktop = () => window.innerWidth >= 992;

    document.querySelectorAll(".slider-main_component").forEach((slider) => {
      const swiperEl = slider.querySelector(".swiper");
      const bulletWrapper = slider.querySelector(".swiper-bullet-wrapper");

      if (swiperEl && bulletWrapper) {
        const swiper = new Swiper(swiperEl, {
          speed: 500,
          loop: true,
          centeredSlides: false,
          slidesPerView: "auto",
          spaceBetween: 32,
          mousewheel: { forceToAxis: true },
          keyboard: { enabled: true, onlyInViewport: true },
          pagination: {
            el: bulletWrapper,
            bulletActiveClass: "is-active",
            bulletClass: "swiper-bullet",
            clickable: true,
          },
          breakpoints: {
            480: { slidesPerView: 1, centeredSlides: false },
            768: { slidesPerView: 1, centeredSlides: false },
            992: { slidesPerView: 3 },
          },
          on: {
            init(sw) {
              updateActiveClass(sw);
            },
            // Step 1: Fade out current active slide's content (desktop only)
            slideChangeTransitionStart(sw) {
              if (!isDesktop()) return;
              const currentActive = sw.slides[sw.activeIndex];
              if (!currentActive) return;
              const content = currentActive.querySelector(
                ".slide_social-proof_content-wrap",
              );
              if (!content) return;
              content.style.transition = "opacity 500ms ease-out";
              content.style.opacity = "0";
            },
            // Step 2+3: Swap .is-active, then fade new content in (desktop only)
            slideChangeTransitionEnd(sw) {
              updateActiveClass(sw);
              if (!isDesktop()) return;
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  const newActive = sw.slides[sw.activeIndex];
                  if (!newActive) return;
                  const content = newActive.querySelector(
                    ".slide_social-proof_content-wrap",
                  );
                  if (!content) return;
                  content.style.transition = "opacity 500ms ease-out 200ms";
                  content.style.opacity = "1";
                });
              });
            },
          },
        });

        function updateActiveClass(sw) {
          sw.slides.forEach((slide) => slide.classList.remove("is-active"));
          const active = sw.slides[sw.activeIndex];
          if (active) active.classList.add("is-active");
        }
      }
    });
  });
