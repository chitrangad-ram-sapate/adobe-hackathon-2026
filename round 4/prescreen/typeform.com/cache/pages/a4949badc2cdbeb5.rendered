  </div></div></div></div></div><div class="spacer-small"></div><div class="u-container"><div class="h2-tab_description-mobile">Build forms that adapt to every respondent and then analyze your data for rich insights. </div></div></div><div class="h2-tab_content-item"><div class="h2-tab_wistia-component"><div data-corner-radius="rounded-desktop" data-aspect-ratio="auto" data-wf--media-slot-wistia-player--variant="base" class="wistia-player_wrap"><div data-wistia-id="zki3yjc4q4" class="wistia-player"><div class="wistia_responsive_padding"><div class="wistia_responsive_wrapper"><div class="wistia_embed_placeholder"></div></div></div><div class="w-embed"><div class="wistia_embed_placeholder" id="wistia-video">
  </div></div></div></div></div><div class="spacer-small"></div><div class="u-container"><div class="h2-tab_description-mobile">Convert and keep customers with automated AI segmentation and follow-ups.</div></div></div><div class="h2-tab_content-item"><div class="h2-tab_wistia-component"><div data-corner-radius="rounded-desktop" data-aspect-ratio="auto" data-wf--media-slot-wistia-player--variant="base" class="wistia-player_wrap"><div data-wistia-id="t7cmlcvvv1" class="wistia-player"><div class="wistia_responsive_padding"><div class="wistia_responsive_wrapper"><div class="wistia_embed_placeholder"></div></div></div><div class="w-embed"><div class="wistia_embed_placeholder" id="wistia-video">
  </div></div></div></div></div><div class="spacer-small"></div><div class="u-container"><div class="h2-tab_description-mobile">Make confident business decisions fast with AI-moderated studies and automated reports. </div></div></div></div></div><div class="js-script w-embed w-script"><script>
  (function () {
    'use strict';

    /* ─── Inject custom tab styles ─────────────────────────────────── */
    var style = document.createElement('style');
    style.textContent = ['.h2-tab_content-item {', '  display: none;', '  opacity: 0;', '}', '.h2-tab_content-item.is-active {', '  display: block;', '  animation: h2TabIn 0.35s ease forwards;', '}', '@keyframes h2TabIn {', '  from { opacity: 0; transform: translateY(10px); }', '  to   { opacity: 1; transform: translateY(0); }', '}', '[data-role="menu-slide"] { cursor: pointer; }'].join('\n');
    document.head.appendChild(style);

    /* ─── Wistia ───────────────────────────────────────────────────── */
    window._wq = window._wq || [];

    function fetchDuration(hashedId) {
      return fetch('https://fast.wistia.com/embed/medias/' + hashedId + '.json')
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          var dur = data && data.media && data.media.duration;
          return typeof dur === 'number' && dur > 0 ? dur : null;
        })
        .catch(function (err) {
          console.warn('[H2Tab] duration fetch failed for', hashedId, err);
          return null;
        });
    }

    function initTabComponent(tabEl) {
      var menuEl = tabEl.querySelector('[data-role="menu"]');
      var menuItems = Array.from(tabEl.querySelectorAll('[data-role="menu-slide"]'));
      var contentItems = Array.from(tabEl.querySelectorAll('.h2-tab_content-item'));

      if (!menuEl || !menuItems.length || !contentItems.length) return;

      /* Detect which tab is marked active in the markup */
      var initialIndex = 0;
      for (var j = 0; j < menuItems.length; j++) {
        if (menuItems[j].classList.contains('w--current') || menuItems[j].classList.contains('is-active')) {
          initialIndex = j;
          break;
        }
      }

      var progressBars = menuItems.map(function (item) {
        return item.querySelector('.h2-tab_progress-active');
      });

      var videoIds = contentItems.map(function (item) {
        var el = item.hasAttribute('data-wistia-id') ? item : item.querySelector('[data-wistia-id]');
        return el ? el.getAttribute('data-wistia-id') : null;
      });

      Promise.all(
        videoIds.map(function (id) {
          return id ? fetchDuration(id) : Promise.resolve(null);
        }),
      ).then(function (durations) {
        bootComponent(menuEl, menuItems, contentItems, progressBars, videoIds, durations, initialIndex);
      });
    }

    function bootComponent(menuEl, menuItems, contentItems, progressBars, videoIds, durations, initialIndex) {
      var players = new Array(menuItems.length).fill(null);
      var isPlaying = new Array(menuItems.length).fill(false);
      var hasAdvanced = new Array(menuItems.length).fill(false);
      var currentIndex = typeof initialIndex === 'number' && initialIndex >= 0 ? initialIndex : 0;
      var swiper = null;

      /* ── Progress bar helpers ──────────────────────────────────── */
      progressBars.forEach(function (bar) {
        if (!bar) return;
        bar.style.width = '100%';
        bar.style.transformOrigin = '0 50%';
        bar.style.willChange = 'transform';
        bar.style.transform = 'scaleX(0)';
        bar.style.transition = 'none';
      });

      function resetBar(index) {
        var bar = progressBars[index];
        if (bar) bar.style.transform = 'scaleX(0)';
      }

      function setBarProgress(index, progress) {
        var bar = progressBars[index];
        if (!bar) return;
        bar.style.transform = 'scaleX(' + Math.max(0, Math.min(progress, 1)) + ')';
      }

      /* ── Tab activation ────────────────────────────────────────── */
      function activateTab(index) {
        menuItems.forEach(function (item, i) {
          item.classList.toggle('is-active', i === index);
          item.classList.toggle('w--current', i === index);
        });

        contentItems.forEach(function (item, i) {
          if (i === index) {
            item.classList.add('is-active');
          } else {
            item.classList.remove('is-active');
          }
        });
      }

      /* ── Tab switching ─────────────────────────────────────────── */
      function switchToTab(index) {
        if (index === currentIndex) return;

        // Pause all other players and reset progress
        players.forEach(function (player, i) {
          if (player && i !== index) {
            player.pause();
            player.time(0);
          }
        });
        progressBars.forEach(function (_, i) {
          if (i !== index) resetBar(i);
        });
        hasAdvanced.fill(false);

        currentIndex = index;
        activateTab(currentIndex);

        if (swiper && swiper.activeIndex !== index) {
          // Use slideTo to update activeIndex, trigger events, and animate
          swiper.slideTo(index, 0, false); // zero duration, no callback

          // Force the last slide to start at the wrapper left edge on mobile
          var isMobile = window.innerWidth < 992;
          var isLastSlide = index === menuItems.length - 1;
          if (isMobile && isLastSlide) {
            // slidesGrid contains left positions of each slide relative to container start
            var maxTranslate = -(swiper.slidesGrid[index] || 0);
            swiper.setTranslate(maxTranslate);
          }
        }

        // Start playing the incoming video
        var incoming = players[currentIndex];
        if (incoming) {
          if (incoming.time() > 0.5) incoming.time(0);
          incoming.play();
        }
      }
      /* Set the initial state */
      activateTab(currentIndex);

      /* ── Swiper init ───────────────────────────────────────────── */
      if (typeof window.Swiper === 'function') {
        swiper = new window.Swiper(menuEl, {
          slidesPerView: 'auto',
          spaceBetween: 16,
          centeredSlides: false,
          slideToClickedSlide: true,
          initialSlide: currentIndex,
          freeMode: true,
          freeModeMomentum: false,
          breakpoints: {
            992: {
              slidesPerView: 3,
              spaceBetween: 12,
              centeredSlides: false,
              allowTouchMove: false,
              slideToClickedSlide: true,
            },
          },
        });

        /* Tab switch runs on slideChange (swipes + slideToClickedSlide) */
        swiper.on('slideChange', function () {
          switchToTab(swiper.activeIndex);
        });

        /* Pre-warm play() inside the touchEnd gesture window so iOS
     allows Wistia to start. snapIndex = the slide swiper is
     about to settle on. Safe to call early — switchToTab below
     will pause everything else anyway. */
        swiper.on('touchEnd', function () {
          var targetIdx = typeof swiper.snapIndex === 'number' ? swiper.snapIndex : swiper.activeIndex;
          var target = players[targetIdx];
          if (target && targetIdx !== currentIndex) {
            target.play();
          }
        });
      }

      menuItems.forEach(function (item, i) {
        item.addEventListener('click', function () {
          switchToTab(i);
        });
      });

      /* ── rAF tick for progress bar ─────────────────────────────── */
      function tick() {
        var activePlayer = players[currentIndex];
        var duration = durations[currentIndex];

        if (activePlayer) {
          if (!duration && typeof activePlayer.duration === 'function') {
            duration = activePlayer.duration();
            if (duration) durations[currentIndex] = duration;
          }

          if (duration) {
            var t = typeof activePlayer.time === 'function' ? activePlayer.time() : 0;
            setBarProgress(currentIndex, t / duration);

            if (t < 1) hasAdvanced[currentIndex] = false;

            if (isPlaying[currentIndex] && !hasAdvanced[currentIndex] && duration - t <= 0.2) {
              hasAdvanced[currentIndex] = true;
              switchToTab((currentIndex + 1) % menuItems.length);
            }
          }
        }

        window.requestAnimationFrame(tick);
      }

      /* ── Wistia player bindings ────────────────────────────────── */
      videoIds.forEach(function (videoId, i) {
        if (!videoId) return;

        _wq.push({
          id: videoId,
          onReady: function (video) {
            players[i] = video;

            if (!durations[i] && typeof video.duration === 'function') {
              durations[i] = video.duration();
            }

            video.time(0);

            video.bind('play', function () {
              isPlaying[i] = true;
              if (video.time() < 1) hasAdvanced[i] = false;
            });

            video.bind('pause', function () {
              isPlaying[i] = false;
            });

            video.bind('end', function () {
              if (i === currentIndex) {
                hasAdvanced[i] = true;
                switchToTab((currentIndex + 1) % menuItems.length);
              }
            });

            video.play();

            /* Only keep the initial tab's video playing */
            if (i !== currentIndex) {
              setTimeout(function () {
                if (players[i]) players[i].pause();
              }, 100);
            }
          },
        });
      });

      window.requestAnimationFrame(tick);
    }

    /* ── Init ────────────────────────────────────────────────────── */
    function init() {
      document.querySelectorAll('.h2-tab_tab').forEach(initTabComponent);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script></div></div></div></div></div><div data-wf--atom-section-padding--padding="none" class="section-padding_wrap w-variant-0f57ca90-4223-f196-349b-a0cdbea18429"></div><div class="hero-stacked_bg-img"><div class="w-embed"></div></div></section><div class="u-embed-js w-embed w-script"><script>
document.addEventListener('DOMContentLoaded', () => {
  const CONFIG = {
    blobSize: 91,
    blobBlur: 43,
    trailLength: 32,
    trailStretch: 0.15,
    smoothing: 0.32,
    outerGlowBlur: 211,
    outerGlowOpacity: 0.25,
    innerGlowBlur: 60,
    innerGlowOpacity: 0.4,
    blendmode: 'lighten',
    idlePulseSize: 30,
    idlePulseSpeed: 0.008,
    colorCore: '#E9BDFB',
    colorMid: '#AE61CD',
    colorEdge: '#792F9B',
  };

  const canvas = document.getElementById('canvas');
  const heroWrap = document.querySelector('#home-hero');

  if (!canvas || !heroWrap) return;

  const ctx = canvas.getContext('2d');
  const offCanvas = document.createElement('canvas');
  const offCtx = offCanvas.getContext('2d');

  const desktopQuery = window.matchMedia('(min-width: 992px)');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  let dpr = window.devicePixelRatio || 1;
  let animationId = null;
  let initialized = false;
  let prefersReducedMotion = motionQuery.matches;

  const mouse = { x: 0, y: 0 };
  const blobPos = { x: 0, y: 0 };
  const prevBlobPos = { x: 0, y: 0 };

  const trail = [];

  let isIdle = true;
  let idleFrames = 0;
  let isOnCanvas = false;

  canvas.style.display = 'none';
  canvas.style.pointerEvents = 'none';

  function getLocalPoint(e) {
    const rect = heroWrap.getBoundingClientRect();

    return {
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
    };
  }

  function alphaHex(a) {
    return Math.round(Math.min(1, Math.max(0, a)) * 255)
      .toString(16)
      .padStart(2, '0');
  }

  function resize() {
    const rect = heroWrap.getBoundingClientRect();
    dpr = window.devicePixelRatio || 1;

    canvas.width = Math.max(1, Math.round(rect.width * dpr));
    canvas.height = Math.max(1, Math.round(rect.height * dpr));
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;

    offCanvas.width = canvas.width;
    offCanvas.height = canvas.height;

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    if (!isOnCanvas && trail.length === 0) {
      mouse.x = rect.width / 2;
      mouse.y = rect.height / 2;
      blobPos.x = mouse.x;
      blobPos.y = mouse.y;
      prevBlobPos.x = mouse.x;
      prevBlobPos.y = mouse.y;
    }
  }

  function setMousePosition(e) {
    const p = getLocalPoint(e);
    mouse.x = p.x;
    mouse.y = p.y;
  }

  function handlePointerEnter(e) {
    isOnCanvas = true;
    isIdle = false;
    idleFrames = 0;
    setMousePosition(e);
    blobPos.x = mouse.x;
    blobPos.y = mouse.y;
    prevBlobPos.x = mouse.x;
    prevBlobPos.y = mouse.y;
  }

  function handlePointerMove(e) {
    setMousePosition(e);
    isIdle = false;
    idleFrames = 0;
  }

  function handlePointerLeave() {
    isOnCanvas = false;
    isIdle = true;
    idleFrames = 0;
  }

  function clearMainCanvas() {
    const w = canvas.width / dpr;
    const h = canvas.height / dpr;

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
  }

  function updateTrail() {
    prevBlobPos.x = blobPos.x;
    prevBlobPos.y = blobPos.y;

    blobPos.x = mouse.x;
    blobPos.y = mouse.y;

    if (prefersReducedMotion) {
      trail.length = 0;
      return;
    }

    const vx = blobPos.x - prevBlobPos.x;
    const vy = blobPos.y - prevBlobPos.y;
    const speed = Math.sqrt(vx * vx + vy * vy);

    if (speed < 0.5) {
      idleFrames += 1;
      if (idleFrames > 10) isIdle = true;
    } else {
      idleFrames = 0;
      isIdle = false;
    }

    const pulse = isIdle
      ? Math.sin(idleFrames * CONFIG.idlePulseSpeed) *
        CONFIG.idlePulseSize
      : 0;

    trail.push({
      x: blobPos.x,
      y: blobPos.y,
      vx,
      vy,
      age: 0,
      radius: CONFIG.blobSize + pulse + speed * CONFIG.trailStretch,
    });

    for (let i = trail.length - 1; i >= 0; i -= 1) {
      trail[i].age += 1;
      if (trail[i].age > CONFIG.trailLength) trail.splice(i, 1);
    }
  }

  function renderBlob() {
    const w = canvas.width / dpr;
    const h = canvas.height / dpr;

    clearMainCanvas();

    if (trail.length === 0) return;

    offCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    offCtx.clearRect(0, 0, w, h);
    offCtx.save();
    offCtx.globalCompositeOperation = CONFIG.blendmode;

    trail.forEach((p) => {
      const life = 1 - p.age / CONFIG.trailLength;
      const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
      const angle = Math.atan2(p.vy, p.vx);
      const stretch = 1 + speed * CONFIG.trailStretch * 0.034;
      const radius = p.radius * life;

      offCtx.save();
      offCtx.translate(p.x, p.y);
      offCtx.rotate(angle);
      offCtx.scale(stretch, 1 / Math.sqrt(stretch));

      const gradient = offCtx.createRadialGradient(0, 0, 0, 0, 0, radius);
      gradient.addColorStop(0, CONFIG.colorCore + alphaHex(life * 0.9));
      gradient.addColorStop(0.4, CONFIG.colorMid + alphaHex(life * 0.5));
      gradient.addColorStop(0.8, CONFIG.colorEdge + alphaHex(life * 0.08));
      gradient.addColorStop(1, CONFIG.colorEdge + '00');

      offCtx.fillStyle = gradient;
      offCtx.beginPath();
      offCtx.arc(0, 0, radius, 0, Math.PI * 2);
      offCtx.fill();
      offCtx.restore();
    });

    offCtx.restore();

    ctx.save();
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.filter = `blur(${CONFIG.outerGlowBlur}px)`;
    ctx.globalAlpha = CONFIG.outerGlowOpacity;
    ctx.drawImage(offCanvas, 0, 0, w, h);

    ctx.filter = `blur(${CONFIG.innerGlowBlur}px)`;
    ctx.globalAlpha = CONFIG.innerGlowOpacity;
    ctx.drawImage(offCanvas, 0, 0, w, h);

    ctx.filter = CONFIG.blobBlur > 0 ? `blur(${CONFIG.blobBlur}px)` : 'none';
    ctx.globalAlpha = 1;
    ctx.drawImage(offCanvas, 0, 0, w, h);

    ctx.restore();
  }

  function renderReducedMotion() {
    clearMainCanvas();

    const r = CONFIG.blobSize;
    const g = ctx.createRadialGradient(
      blobPos.x,
      blobPos.y,
      0,
      blobPos.x,
      blobPos.y,
      r,
    );

    g.addColorStop(0, CONFIG.colorCore);
    g.addColorStop(1, 'transparent');

    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(blobPos.x, blobPos.y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  function animate() {
    if (!initialized) return;

    updateTrail();

    if (prefersReducedMotion) {
      renderReducedMotion();
    } else {
      renderBlob();
    }

    animationId = requestAnimationFrame(animate);
  }

  function init() {
    if (initialized || !desktopQuery.matches) return;

    initialized = true;
    canvas.style.display = 'block';
    heroWrap.style.touchAction = 'none';

    heroWrap.addEventListener('pointerenter', handlePointerEnter);
    heroWrap.addEventListener('pointermove', handlePointerMove);
    heroWrap.addEventListener('pointerdown', handlePointerEnter);
    heroWrap.addEventListener('pointerleave', handlePointerLeave);
    heroWrap.addEventListener('pointercancel', handlePointerLeave);
    window.addEventListener('resize', resize);

    trail.length = 0;
    resize();
    animate();
  }

  function destroy() {
    if (!initialized) return;

    initialized = false;

    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }

    heroWrap.removeEventListener('pointerenter', handlePointerEnter);
    heroWrap.removeEventListener('pointermove', handlePointerMove);
    heroWrap.removeEventListener('pointerdown', handlePointerEnter);
    heroWrap.removeEventListener('pointerleave', handlePointerLeave);
    heroWrap.removeEventListener('pointercancel', handlePointerLeave);
    window.removeEventListener('resize', resize);

    trail.length = 0;
    isOnCanvas = false;
    isIdle = true;
    idleFrames = 0;

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    offCtx.setTransform(1, 0, 0, 1, 0, 0);
    offCtx.clearRect(0, 0, offCanvas.width, offCanvas.height);

    canvas.style.display = 'none';
    heroWrap.style.touchAction = '';
  }

  function handleBreakpointChange() {
    if (desktopQuery.matches) {
      init();
    } else {
      destroy();
    }
  }

  function handleMotionChange(e) {
    prefersReducedMotion = e.matches;
  }

  if (desktopQuery.addEventListener) {
    desktopQuery.addEventListener('change', handleBreakpointChange);
  } else {
    desktopQuery.addListener(handleBreakpointChange);
  }

  if (motionQuery.addEventListener) {
    motionQuery.addEventListener('change', handleMotionChange);
  } else {
    motionQuery.addListener(handleMotionChange);
  }

  handleBreakpointChange();
});
</script></div></div><div cc-t-value="down" cc-t-event="page_navigated" cc-t-in_view="true" cc-t-in_view_allow_multipe="false" cc-t-item="scroll" cc-t-item_type="button" cc-t-location="body:section-1" class="cc_t-pixel-in_view" data-in-view="false"><div class="pixel_label-css w-embed"><style>
