<aside class="modal js-modal ingredients-modal" id="modalIngredients-template--22541868204277__collapsible_content_T3FFEz" aria-hidden="true" aria-labelledby="modalTitle-template--22541868204277__collapsible_content_T3FFEz" role="dialog">
      <div class="modal__inner modal__inner--bottom-mobile">
        <header class="modal__header">
          <h3 id="modalTitle-template--22541868204277__collapsible_content_T3FFEz" class="modal__header-title">
