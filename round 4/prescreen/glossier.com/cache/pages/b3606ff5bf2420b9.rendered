  <p class="bag__free-shipping-progress-text hide" id="bagFreeShippingReached">Congrats! You get free express shipping</p>
  <p class="bag__free-shipping-progress-text" id="bagFreeShippingNotReached"><span id="bagAmountFromFreeShipping">Rs. 11,230 </span> away from free express shipping</p>
  <div class="bag__free-shipping-progress">
    <div class="bag__free-shipping-progress--inner" style="width: 0.0%" id="bagFreeShippingProgress"></div>
  </div>
</div>

           

        
<div id="bagGwpWrapper" class="bag__gwp-wrapper"><button type="button" class="bag__gwp-header js-gwp-header">
