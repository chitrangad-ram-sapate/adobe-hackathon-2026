#onetrust-consent-sdk #onetrust-banner-sdk *:focus, #onetrust-consent-sdk #onetrust-banner-sdk:focus {
    outline: none;
}

#onetrust-consent-sdk #onetrust-banner-sdk {
    border-radius: 0;
    box-shadow: none;
}

@media (max-width: 768px) {
    #onetrust-consent-sdk #onetrust-banner-sdk {
        width: 100%;
        max-width: 100%;
        right: 0;
    }
    #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {
        flex-direction: column;
    }
    #onetrust-banner-sdk .banner-actions-container {
        display: flex;
        margin-bottom: 16px;
    }
    #onetrust-banner-sdk .banner-actions-container > * {
        flex: 1;
    }
    #onetrust-consent-sdk #onetrust-pc-btn-handler,
    #onetrust-consent-sdk #onetrust-pc-btn-handler.cookie-setting-link {
        align-self: flex-start;
    }
}

@media (min-width: 769px) {
    #onetrust-consent-sdk #onetrust-banner-sdk {
        width: 517px;
        max-width: 517px;
    }
}

#onetrust-banner-sdk .banner-header {
    display: none;
}

#onetrust-banner-sdk #onetrust-policy {
    margin-top: 0;
}

#onetrust-banner-sdk #onetrust-policy-title {
    font-weight: 500;
    font-size: 14px;
    line-height: 140%;
    padding: 10px 16px;
}

#onetrust-banner-sdk .ot-close-icon {
    background-image: url("https://cdn.shopify.com/s/files/1/0627/9164/7477/files/onetrust-close-icon.svg?v=1679946715") !important;
    width: 16px;
    height: 16px;
}

#onetrust-banner-sdk .ot-close-icon:hover {
    opacity: 1;
}

#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text {
    border-top: 1px solid rgba(0,0,0,0.06);
    border-top: 1px solid rgba(0,0,0,0.06);
    padding: 16px 16px 24px 16px;
    font-size: 12px;
    line-height: 140%;
}

#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text a {
    color: black;
}

#onetrust-consent-sdk #onetrust-banner-sdk #onetrust-button-group {
    display: flex;
    margin-right: 0;
    justify-content: flex-end;
}

#onetrust-banner-sdk #onetrust-button-group-parent {
    padding: 0 16px 16px 16px
}

#onetrust-banner-sdk .banner-actions-container {
    display: flex;
    flex-grow: 1;
}

#onetrust-consent-sdk #onetrust-pc-btn-handler,
#onetrust-consent-sdk #onetrust-pc-btn-handler.cookie-setting-link {
    border: 0;
    padding: 0;
    margin: 0;
    width: auto;
    font-weight: normal;
    text-decoration: underline;
}

#onetrust-consent-sdk #onetrust-pc-btn-handler:hover,
#onetrust-consent-sdk #onetrust-pc-btn-handler.cookie-setting-link:hover {
    opacity: 1;
}

#onetrust-banner-sdk #onetrust-close-btn-container,
#onetrust-consent-sdk #onetrust-accept-btn-handler,
#onetrust-banner-sdk #onetrust-reject-all-handler {
    -webkit-animation: 1.5s linear infinite paused marching-ants-full-1;
    animation: 1.5s linear infinite paused marching-ants-full-1;
}

#onetrust-banner-sdk #onetrust-close-btn-container,
#onetrust-consent-sdk #onetrust-accept-btn-handler {
    background-size: 0 0,100% 1px,0 0,1px 100%;
    background-position: 0 0,0 100%,0 0,100% 0;
    background-repeat: repeat-x,repeat-x,repeat-y,repeat-y;
    background-image: none,-webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,#000)),none,-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,#000));
    background-image: none,linear-gradient(to right,#000 50%,#000 50%),none,linear-gradient(to bottom,#000 50%,#000 50%);
}

#onetrust-consent-sdk #onetrust-accept-btn-handler {
    background-color: #f7f7f7;
}

#onetrust-banner-sdk #onetrust-reject-all-handler {
    background-color: #fff;
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: repeat-x;
    background-image: none,-webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,#000)),none,none;
    background-image: none,linear-gradient(to right,#000 50%,#000 50%),none,none;
}

#onetrust-banner-sdk #onetrust-close-btn-container {
    background-image: none;
    width: 16px;
    height: 16px;
    top: 12px;
    right: 16px;
}

#onetrust-consent-sdk #onetrust-accept-btn-handler,
#onetrust-banner-sdk #onetrust-reject-all-handler {
    font-weight: normal;
    width: auto;
    border: 0;
    margin-right: 16px;
    margin-bottom: 0;
    padding: 10px 16px;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0.03em;
}

#onetrust-banner-sdk #onetrust-close-btn-container:hover,
#onetrust-consent-sdk #onetrust-accept-btn-handler:hover,
#onetrust-banner-sdk .ot-pc-refuse-all-handler:hover {
    background-size: 5px 0.5px,5px 0.5px,0.5px 5px,0.5px 5px !important;;
    background-position: 0 0,0 100%,0 0,100% 0 !important;;
    background-repeat: repeat-x,repeat-x,repeat-y,repeat-y !important;;
    -webkit-animation-play-state: running !important;;
    animation-play-state: running !important;;
    background-image: -webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,transparent)) !important;;
    background-image: linear-gradient(to right,#000 50%,transparent 50%),linear-gradient(to right,#000 50%,transparent 50%),linear-gradient(to bottom,#000 50%,transparent 50%),linear-gradient(to bottom,#000 50%,transparent 50%) !important;
    opacity: 1;
}

@keyframes marching-ants-full-1 {
    0% {
        background-position: 0 0,0 100%,0 0,100% 0;
    }
    100% {
        background-position: 10px 0,-10px 100%,0 -10px,100% 10px;
    }
