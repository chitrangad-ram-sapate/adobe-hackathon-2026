#onetrust-pc-sdk #accept-recommended-btn-handler,
#onetrust-pc-sdk .ot-pc-refuse-all-handler,
#onetrust-pc-sdk .ot-close-cntr {
    background-size: 0 0,100% 1px,0 0,1px 100%;
    background-position: 0 0,0 100%,0 0,100% 0;
    background-repeat: repeat-x,repeat-x,repeat-y,repeat-y;
    background-image: none,-webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,#000)),none,-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,#000));
    background-image: none,linear-gradient(to right,#000 50%,#000 50%),none,linear-gradient(to bottom,#000 50%,#000 50%);
    -webkit-animation: 1.5s linear infinite paused marching-ants-full-1;
    animation: 1.5s linear infinite paused marching-ants-full-1;
}

#onetrust-pc-sdk .save-preference-btn-handler,
#onetrust-pc-sdk #accept-recommended-btn-handler,
#onetrust-pc-sdk .ot-pc-refuse-all-handler {
    font-weight: normal !important;
    width: auto !important;
    border: 0 !important;
    margin-right: 16px !important;
    margin-bottom: 0 !important;
    padding: 10px 16px !important;
    font-size: 14px !important;
    line-height: 140% !important;
    letter-spacing: 0.03em !important;
    background-color: #f7f7f7 !important;
    color: black !important;
    margin-bottom: 20px !important;
}

#onetrust-pc-sdk .ot-close-cntr {
    background-image: none;
    width: 16px !important;
    height: 16px !important;
    top: 12px !important;
    right: 16px !important;
}

#onetrust-pc-sdk .save-preference-btn-handler:hover,
#onetrust-pc-sdk #accept-recommended-btn-handler:hover,
#onetrust-pc-sdk .ot-pc-refuse-all-handler:hover,
#onetrust-pc-sdk .ot-close-cntr:hover {
    background-size: 5px 0.5px,5px 0.5px,0.5px 5px,0.5px 5px;
    background-position: 0 0,0 100%,0 0,100% 0;
    background-repeat: repeat-x,repeat-x,repeat-y,repeat-y;
    -webkit-animation-play-state: running;
    animation-play-state: running;
    background-image: -webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,right top,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,transparent)),-webkit-gradient(linear,left top,left bottom,color-stop(50%,#000),color-stop(50%,transparent));
    background-image: linear-gradient(to right,#000 50%,transparent 50%),linear-gradient(to right,#000 50%,transparent 50%),linear-gradient(to bottom,#000 50%,transparent 50%),linear-gradient(to bottom,#000 50%,transparent 50%);
    opacity: 1 !important;
}

#onetrust-pc-sdk #close-pc-btn-handler {
    background-image: url("https://cdn.shopify.com/s/files/1/0627/9164/7477/files/onetrust-close-icon.svg?v=1679946715") !important;
    width: 16px !important;
    height: 16px !important;
}

#onetrust-pc-sdk #ot-pc-desc a {
    margin: 0 !important;
    color: inherit !important;
    text-decoration: underline !important;
}

#onetrust-pc-sdk #ot-pc-desc a:hover {
    color: inherit !important;
}

#onetrust-pc-sdk .ot-switch-nob:before {
    background-image: none !important;
    border: 0 !important;
}

.ot-btn-container {
    display: flex;
}

.ot-btn-subcntr {
    display: flex;
    flex-direction: row-reverse;
}

@keyframes marching-ants-full-1 {
    0% {
        background-position: 0 0,0 100%,0 0,100% 0;
    }
    100% {
        background-position: 10px 0,-10px 100%,0 -10px,100% 10px;
    }
