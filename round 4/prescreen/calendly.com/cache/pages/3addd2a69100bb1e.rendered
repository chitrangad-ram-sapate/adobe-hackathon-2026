@supports (padding: max(0px)) {
  .banner-mobile-bottom {
    bottom: 0px !important;
  }

  /* CSS Collision where text is uppercase */
  #lanyard_root * {
    text-transform: none;
  }
}
/*
 * When an experience is a stack-manager promotion remount (an already-shown experience re-homed
 * into a wrapper), suppress its ENTRANCE animation so it doesn't replay — it should appear
 * unchanged. Entrance animation classes contain "Animate"/"Animated"; dismiss classes contain
 * "Dismiss". During a dismiss the element carries both, so :not([class*="Dismiss"]) keeps the
 * dismiss animation working while only neutralizing the entrance.
 */
.ketch-suppress-enter-animation [class*="Animate"]:not([class*="Dismiss"]) {
  animation: none !important;
}
