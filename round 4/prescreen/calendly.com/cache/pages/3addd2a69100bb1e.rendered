ge" content="https://calendly.com/media/OgImage-v2.png"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://calendly.com#organization","name":"Calendly","url":"https://calendly.com","logo":{"@type":"ImageObject","@id":"https://calendly.com#logo","url":"https://calendly.com/media/logo.svg","contentUrl":"https://calendly.com/media/logo.svg"},"sameAs":["https://x.com/calendly","https://www.facebook.com/Calendly","https://www.instagram.com/calendly","https://www.youtube.com/c/Calendly","https://www.linkedin.com/company/calendly/life/lifeatcalendly"]},{"@type":"WebSite","@id":"https://calendly.com#website","url":"https://calendly.com","name":"Calendly","publisher":{"@id":"https://calendly.com#organization"}}]}</script><script>(function(){const sidecarClientKey = "client-P1rPx0qCePYh8uvPAHpIxoJ3PTiKIbrto2nhpxbj4hC";
const sidecarEnvironment = "production";
const sidecarEnabled = false;
const sidecarScriptUrl = "";

(function () {
	const sidecarScriptId = 'statsig-sidecar-script';
	const stableIdStorageKey = 'STATSIG_LOCAL_STORAGE_STABLE_ID';
	const targetingGroup = 'C0004';
	const fallbackTimeoutMs = 3000;

	function getCookie(name) {
		const prefix = name + '=';
		const cookie = document.cookie.split('; ').find(function (value) {
			return value.indexOf(prefix) === 0;
		});

		if (!cookie) return null;

		try {
			return decodeURIComponent(cookie.slice(prefix.length));
		} catch {
			return null;
		}
	}

	function getOptanonGroups() {
		const value = getCookie('OptanonConsent');
		if (!value) return null;

		const groupsParam = value.split('&').find(function (part) {
			return part.indexOf('groups=') === 0;
		});
		if (!groupsParam) return null;

		return groupsParam.slice('groups='.length).split(',').filter(function (group) {
			return group.slice(-2) === ':1';
		}).map(function (group) {
			return group.split(':')[0];
		});
	}

	function getActiveGroups() {
		// Match the shared OneTrust helper: an initialized empty runtime
		// value must override a stale OptanonConsent cookie.
		if (typeof window.OnetrustActiveGroups === 'string') {
			return window.OnetrustActiveGroups.split(',').filter(Boolean);
		}

		const cookieGroups = getOptanonGroups();

		return cookieGroups || [];
	}

	function targetingConsentGranted() {
		return getActiveGroups().indexOf(targetingGroup) !== -1;
	}

	function syncConsentMarker() {
		window.__calendlyStatsigTargetingConsentGranted = targetingConsentGranted();
	}

	function getStorageValue(key) {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	}

	function setStorageValue(key, value) {
		try {
			localStorage.setItem(key, value);
		} catch {
			// Storage can be unavailable in privacy-restricted browsers.
		}
	}

	function getAnonymousId() {
		let anonymousId = getCookie('cal_anonymous_id');
		if (anonymousId) return anonymousId;
		if (!window.crypto || !window.crypto.randomUUID) return '';

		anonymousId = window.crypto.randomUUID();
		const expires = new Date();
		expires.setFullYear(expires.getFullYear() + 1);
		document.cookie = 'cal_anonymous_id=' + encodeURIComponent(anonymousId)
						+ '; expires=' + expires.toUTCString() + '; path=/; SameSite=Lax';

		return anonymousId;
	}

	function getStableId() {
		const existingId = getStorageValue(stableIdStorageKey);
		if (existingId) return existingId;
		if (!window.crypto || !window.crypto.randomUUID) return '';

		const stableId = window.crypto.randomUUID();
		setStorageValue(stableIdStorageKey, stableId);

		return stableId;
	}

	function buildUser() {
		const hasTargetingConsent = targetingConsentGranted();
		const existingAnonymousId = getCookie('cal_anonymous_id');
		const anonymousId = hasTargetingConsent ? getAnonymousId() : existingAnonymousId;
		const stableId = hasTargetingConsent ? getStableId() : '';
		const userId = getStorageValue('ajs_user_id') || anonymousId || undefined;
		const userData = getStorageValue('userData');
		let email;

		try {
			email = userData ? JSON.parse(userData).email : undefined;
		} catch {
			email = undefined;
		}

		return {
			userID: userId,
			customIDs: {
				...(anonymousId && { cal_anonymous_id: anonymousId }),
				...(stableId && { stableID: stableId }),
			},
			email: email,
			locale: (document.documentElement.lang || 'en-US').replace('-US', ''),
			custom: {
				loggedIn: getStorageValue('CALENDLY_AUTHENTICATED_USER_STATUS') === 'true',
				screenWidth: window.innerWidth,
			},
		};
	}

	window.__calendlyStatsigGetUser = function () {
		const user = buildUser();
		window.statsigUser = user;

		return user;
	};

	function getScriptUrl() {
		if (!sidecarEnabled || !sidecarScriptUrl) return null;

		const url = new URL(sidecarScriptUrl, window.location.origin);
		if (!url.searchParams.has('apikey')) url.searchParams.set('apikey', sidecarClientKey);

		return url.toString();
	}

	function runtimeOptions() {
		return {
			loggingEnabled: 'browser-only',
			disableStorage: false,
			networkConfig: {
				api: 'https://ss.calendly.com',
				logEventUrl: 'https://ss.calendly.com/prod-health',
				initializeUrl: 'https://ss.calendly.com/prod-sync',
			},
			environment: sidecarEnvironment ? { tier: sidecarEnvironment } : undefined,
		};
	}

	function clearVisualFallback() {
		document.documentElement.removeAttribute('data-statsig-sidecar-pending');
	}

	function startVisualFallback() {
		document.documentElement.setAttribute('data-statsig-sidecar-pending', 'true');
		window.setTimeout(function () {
			if (!window.__calendlyStatsigSidecarLoaded) clearVisualFallback();
		}, fallbackTimeoutMs);
	}

	function handleSidecarLoad() {
		if (window.__calendlyStatsigSidecarRevoked || !targetingConsentGranted()) {
			const script = document.getElementById(sidecarScriptId);
			if (script) script.remove();
			window.__calendlyStatsigSidecarLoading = false;
			clearVisualFallback();

			return;
		}

		window.__calendlyStatsigSidecarLoaded = true;
		window.__calendlyStatsigSidecarLoading = false;
		clearVisualFallback();
	}

	function handleSidecarError() {
		window.__calendlyStatsigSidecarLoading = false;
		window.__calendlyStatsigSidecarLoaded = false;
		clearVisualFallback();
	}

	window.__calendlyStatsigSidecarOnload = handleSidecarLoad;
	window.__calendlyStatsigSidecarOnerror = handleSidecarError;
	syncConsentMarker();
	window.__calendlyStatsigSidecarExposureQueue = window.__calendlyStatsigSidecarExposureQueue || [];
	window.statsigSidecarConfig = {
		onExperimentEvaluation: function (event) {
			const experiment = event && (event.experimentName || event.experiment?.name);
			const group = event && event.groupName;
			if (!experiment || !group) return;

			const exposure = {
				experiment: experiment,
				group: group
			};
			window.__calendlyStatsigSidecarExposureQueue.push(exposure);
			window.dispatchEvent(new CustomEvent('calendly:statsig-sidecar-exposure', { detail: exposure }));
		},
	};

	function loadSidecar(synchronous) {
		if (!sidecarEnabled || !targetingConsentGranted()) return;
		if (window.__calendlyStatsigSidecarLoaded || window.__calendlyStatsigSidecarLoading) return;
		if (document.getElementById(sidecarScriptId)) return;

		window.__calendlyStatsigSidecarRevoked = false;
		const user = window.__calendlyStatsigGetUser();
		const source = getScriptUrl();
		if (!user || !source) return;

		window.statsigOptions = runtimeOptions();
		window.__calendlyStatsigSidecarLoading = true;
		if (!synchronous) startVisualFallback();

		if (synchronous && document.readyState === 'loading') {
			const escapedSource = source.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
			document.write(
				'<script id="' + sidecarScriptId + '" src="' + escapedSource
							+ '" onload="window.__calendlyStatsigSidecarOnload()"'
							+ ' onerror="window.__calendlyStatsigSidecarOnerror()"><\\/script>',
			);

			return;
		}

		const script = document.createElement('script');
		script.id = sidecarScriptId;
		script.src = source;
		script.async = false;
		script.onload = handleSidecarLoad;
		script.onerror = handleSidecarError;
		document.head.appendChild(script);
	}

	function revokeSidecar() {
		window.__calendlyStatsigSidecarRevoked = true;
		const script = document.getElementById(sidecarScriptId);
		const hadPendingRuntime = Boolean(script || window.__calendlyStatsigSidecarLoading);
		if (script && !window.__calendlyStatsigSidecarLoaded) script.remove();
		window.__calendlyStatsigSidecarLoading = false;
		clearVisualFallback();

		const instance = window.StatsigSidecar && window.StatsigSidecar.getStatsigInstance
			? window.StatsigSidecar.getStatsigInstance()
			: window.__STATSIG__ && window.__STATSIG__.instance
				? window.__STATSIG__.instance()
				: null;

		if (instance && instance.updateRuntimeOptions) {
			instance.updateRuntimeOptions({
				loggingEnabled: 'disabled',
				disableStorage: true,
			});
		}

		if ((window.__calendlyStatsigSidecarLoaded || hadPendingRuntime)
						&& !window.__calendlyStatsigSidecarRevocationHandled) {
			window.__calendlyStatsigSidecarRevocationHandled = true;
			window.location.reload();
		}
	}

	loadSidecar(true);
	window.addEventListener('OneTrustGroupsUpdated', function () {
		syncConsentMarker();
		if (targetingConsentGranted()) {
			loadSidecar(false);
		} else {
			revokeSidecar();
		}
	});
	window.addEventListener('calendly:statsig-consent-granted', function (event) {
		const { user } = (event && event.detail) || {};
		if (user) window.statsigUser = user;
		loadSidecar(false);
	});
}());
