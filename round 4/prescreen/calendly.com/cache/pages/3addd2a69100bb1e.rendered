[&amp;&gt;*:last-child]:mb-0 type-body-md text-text-secondary"><p class="type-h6 font-calendly-sans text-midnight opacity-80 mb-0 last:mb-0">Meetings booked with Calendly</p></div></div><p class="font-wulkan text-[90px] leading-[1.1] tracking-[-1.8px] text-lilac" style="font-feature-settings:&quot;dlig&quot; 1">1.3B+</p></div></div></div></div></div><button type="button" aria-label="Pause scrolling" aria-pressed="false" class="absolute right-md top-md z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-ui-md text-midnight transition-opacity hover:opacity-80 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action-focus-border"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-player-pause " aria-hidden="true"><path d="M6 6a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -12"></path><path d="M14 6a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -12"></path></svg></button></div></div></div></div></div></astro-island></div></section><section id="[About]-Ourleadership" class="flex w-full justify-center bg-surface-bg-primary py-section-default"><div class="z-10 has-data-scrolljack-overlay:z-1001 w-full flex flex-col @container gap-2xl max-w-[1280px] px-(--section-padding-x)"><astro-island uid="259LAE" prefix="r20" component-url="/_astro/index.CmO4VxXq.js" component-export="HeadingIsland" renderer-url="/_astro/client.DSHm9q9k.js" props="{&quot;alignment&quot;:[0,&quot;left&quot;],&quot;title&quot;:[0,&quot;Our leaders&quot;],&quot;headingSize&quot;:[0,&quot;h1&quot;],&quot;headingFont&quot;:[0,&quot;calendly-sans&quot;],&quot;eyebrow&quot;:[0,{&quot;variant&quot;:[0,&quot;eyebrowOverline&quot;],&quot;badgeLabel&quot;:[0,&quot;Leadership&quot;],&quot;accompanyingBadgeLabel&quot;:[0],&quot;badgeSize&quot;:[0,&quot;standard&quot;]}],&quot;body&quot;:[0,&quot;Tope Awotona founded Calendly in 2013 through sheer grit, perseverance, and the complete and utter emptying of his personal savings accounts. With everything on the line, he turned his vision of simple scheduling for everyone into a vibrant, growing platform that manages meetings for more than 50 million individuals and businesses.&quot;],&quot;caption&quot;:[0],&quot;primaryCta&quot;:[0],&quot;secondaryCta&quot;:[0],&quot;popupOptions&quot;:[0,{&quot;locale&quot;:[0,&quot;en-US&quot;],&quot;translations&quot;:[0,{&quot;form_field_required&quot;:[0,&quot;This field is required.&quot;],&quot;form_email_label&quot;:[0,&quot;Email&quot;],&quot;form_email_placeholder&quot;:[0,&quot;your@email.com&quot;],&quot;form_subject_label&quot;:[0,&quot;Subject&quot;],&quot;form_subject_placeholder&quot;:[0,&quot;Brief summary of your issue&quot;],&quot;form_description_label&quot;:[0,&quot;Description&quot;],&quot;form_description_placeholder&quot;:[0,&quot;Please describe your issue in detail&quot;],&quot;form_issue_type_label&quot;:[0,&quot;Issue Type&quot;],&quot;form_issue_billing&quot;:[0,&quot;Billing &amp; Payments&quot;],&quot;form_issue_signin&quot;:[0,&quot;Sign-In Help&quot;],&quot;form_issue_product&quot;:[0,&quot;Product Support&quot;],&quot;form_submit&quot;:[0,&quot;Submit Ticket&quot;],&quot;form_submit_error&quot;:[0,&quot;Something went wrong. Please try again.&quot;],&quot;form_success_title&quot;:[0,&quot;Your ticket has been submitted&quot;],&quot;form_success_description&quot;:[0,&quot;We'll get back to you as soon as possible.&quot;],&quot;form_lead_submit&quot;:[0,&quot;Submit&quot;],&quot;form_error_required&quot;:[0,&quot;This field is required.&quot;],&quot;form_error_email&quot;:[0,&quot;Please enter a valid email address.&quot;],&quot;form_error_business_email&quot;:[0,&quot;Please enter your business email address.&quot;],&quot;form_error_load&quot;:[0,&quot;This form couldn’t load. Please refresh and try again.&quot;]}],&quot;closeLabel&quot;:[0,&quot;Close popup&quot;],&quot;payloadApiUrl&quot;:[0,&quot;https://calendlycms.com&quot;]}],&quot;locale&quot;:[0,&quot;en-US&quot;],&quot;isHero&quot;:[0],&quot;testId&quot;:[0,&quot;section-heading&quot;]}" ssr="" client="visible" opts="{&quot;name&quot;:&quot;HeadingIsland&quot;,&quot;value&quot;:true}" await-children=""><div data-testid="section-heading" style="opacity:0;transform:translateY(25px)"><div data-testid="content-block" class=""><div class="flex flex-col gap-xl w-full items-start text-left ui-tb:max-w-heading"><div class="flex flex-col w-full gap-md items-start text-left"><span class="font-geist type-overline font-semibold text-text-primary">Leadership</span><h2 class="font-calendly-sans type-h1 text-text-primary w-full max-w-subhead ui-dsk:max-w-heading">Our leaders</h2><p class="font-geist text-text-secondary w-full type-body-lg max-w-subhead whitespace-pre-line">Tope Awotona founded Calendly in 2013 through sheer grit, perseverance, and the complete and utter emptying of his personal savings accounts. With everything on the line, he turned his vision of simple scheduling for everyone into a vibrant, growing platform that manages meetings for more than 50 million individuals and businesses.</p></div></div></div></div></astro-island><astro-island uid="Z2gU9SB" prefix="r14" component-url="/_astro/index.CmO4VxXq.js" component-export="CardGridIsland" renderer-url="/_astro/client.DSHm9q9k.js" props="{&quot;heading&quot;:[0,null],&quot;body&quot;:[0],&quot;caption&quot;:[0],&quot;eyebrow&quot;:[0],&quot;alignment&quot;:[0,&quot;centered&quot;],&quot;headingSize&quot;:[0,null],&quot;images&quot;:[1,[]],&quot;cards&quot;:[1,[[0,{&quot;cardType&quot;:[0,&quot;leadership&quot;],&quot;heading&quot;:[0,&quot;Tope Awotona&quot;],&quot;body&quot;:[0,&quot;Tope Awotona is the founder and CEO of Calendly, the scheduling platform that enables individuals, teams, and organizations globally to automate meetings – helping companies close deals, hire candidates, build relationships, and grow their business faster. He founded Calendly in 2013 with the vision of simplifying scheduling for everyone without the back-and-forth emails. With Tope’s strategic direction, the platform has grown and evolved to over 20 million users.\n\nPrior to Calendly, Tope spent the majority of his career in enterprise software sales, working for companies such as IBM, Perceptive Software, and Dell Technologies, in addition to launching a series of startups. He grew up in Lagos, Nigeria and came to the United States in 1996.\n\nTope holds a degree in Management Information Systems from the University of Georgia.&quot;],&quot;badge&quot;:[0,&quot;Founder, Chief Executive Officer&quot;],&quot;href&quot;:[0],&quot;ctaLabel&quot;:[0],&quot;imageSrc&quot;:[0,&quot;https://cdn.calendlycms.com/tope-headshot.png&quot;],&quot;imageAlt&quot;:[0,&quot;&quot;],&quot;videoHashedId&quot;:[0],&quot;videoAspectRatio&quot;:[0],&quot;iconSrc&quot;:[0],&quot;iconSrcs&quot;:[0],&quot;listItems&quot;:[1,[]],&quot;listIcon&quot;:[0],&quot;linkedInHref&quot;:[0,&quot;https://www.linkedin.com/in/bawotona/&quot;],&quot;logoSrc&quot;:[0],&quot;logoAlt&quot;:[0],&quot;stat&quot;:[0],&quot;statLabel&quot;:[0],&quot;statLabelRichText&quot;:[0],&quot;bodyRichText&quot;:[0],&quot;color&quot;:[0],&quot;quote&quot;:[0],&quot;relationTo&quot;:[0,&quot;marketingEntityPeople&quot;],&quot;productSize&quot;:[0],&quot;fullWidth&quot;:[0,false],&quot;unsupportedReason&quot;:[0],&quot;key&quot;:[0,&quot;3xLHKmhd7orop5j03bOrDs&quot;]}],[0,{&quot;cardType&quot;:[0,&quot;leadership&quot;],&quot;heading&quot;:[0,&quot;Shane Murphy-Reuter&quot;],&quot;body&quot;:[0,&quot;Shane Murphy-Reuter is the President of Go-to-Market at Calendly, leading the Sales, Marketing, and Customer Support teams. He's focused on driving brand awareness and demand by ensuring alignment between sales strategies, marketing initiatives, and customer experience.\n\nA B2B software veteran, Shane is an expert at data-driven decision-making and harmonizing product- and sales-led growth strategies to drive scalable growth. Previously he was the CMO at Webflow, where he established and scaled the company's marketing function and led their self-serve business, including product marketing, brand, enterprise demand generation, partner channels, and pricing. Before that, he was the CMO of ZoomInfo, where he helped the company grow to over $1 billion in revenue. He also served as SVP of Marketing at Intercom and VP of Sales and Marketing at AdRoll.\n\nShane currently serves on the board of Stockpress, as a limited partner at Stage 2 Capital, and as an advisor to multiple SaaS companies. He holds a Bachelor of Business &amp; Law from the University College Dublin.&quot;],&quot;badge&quot;:[0,&quot;President of Go-to-Market&quot;],&quot;href&quot;:[0],&quot;ctaLabel&quot;:[0],&quot;imageSrc&quot;:[0,&quot;https://cdn.calendlycms.com/shane-headshot.png&quot;],&quot;imageAlt&quot;:[0,&quot;&quot;],&quot;videoHashedId&quot;:[0],&quot;videoAspectRatio&quot;:[0],&quot;iconSrc&quot;:[0],&quot;iconSrcs&quot;:[0],&quot;listItems&quot;:[1,[]],&quot;listIcon&quot;:[0],&quot;linkedInHref&quot;:[0,&quot;https://www.linkedin.com/in/shanemurfy/&quot;],&quot;logoSrc&quot;:[0],&quot;logoAlt&quot;:[0],&quot;stat&quot;:[0],&quot;statLabel&quot;:[0],&quot;statLabelRichText&quot;:[0],&quot;bodyRichText&quot;:[0],&quot;color&quot;:[0],&quot;quote&quot;:[0],&quot;relationTo&quot;:[0,&quot;marketingEntityPeople&quot;],&quot;productSize&quot;:[0],&quot;fullWidth&quot;:[0,false],&quot;unsupportedReason&quot;:[0],&quot;key&quot;:[0,&quot;5wthSiuxdsp5Gzci7sVFtd&quot;]}],[0,{&quot;cardType&quot;:[0,&quot;leadership&quot;],&quot;heading&quot;:[0,&quot;Shahara Jasion&quot;],&quot;body&quot;:[0,&quot;Shahara Jasion is the CFO at Calendly, where she leads the Finance, Legal, and IT/Systems functions to ensure business excellence and strategic alignment across the organization.\n\nShe has held financial positions at high-growth technology and advisory companies for more than 15 years. Most recently the VP of Finance, Shahara has been instrumental in shaping Calendly’s financial strategy since she joined the company in 2023. Previously, she was the VP of Finance at the global sales enablement software company Seismic, where she also served as the interim CFO and supported the organization through multiple acquisitions and financing rounds. Before that, Shahara spent nearly eight years at Deloitte as a Senior Audit Manager. She began her career working in various accounting and assurance positions at Life Technologies, now part of Thermo Fisher Scientific; public sector software company TriTech Software System, now CentralSquare; and PwC.\n\nShahara holds a Bachelor of Arts in Accountancy from Villanova University.&quot;],&quot;badge&quot;:[0,&quot;Chief Financial Officer&quot;],&quot;href&quot;:[0],&quot;ctaLabel&quot;:[0],&quot;imageSrc&quot;:[0,&quot;https://cdn.calendlycms.com/shahara-headshot.png&quot;],&quot;imageAlt&quot;:[0,&quot;&quot;],&quot;videoHashedId&quot;:[0],&quot;videoAspectRatio&quot;:[0],&quot;iconSrc&quot;:[0],&quot;iconSrcs&quot;:[0],&quot;listItems&quot;:[1,[]],&quot;listIcon&quot;:[0],&quot;linkedInHref&quot;:[0,&quot;https://www.linkedin.com/in/shahara-jasion-51764222/&quot;],&quot;logoSrc&quot;:[0],&quot;logoAlt&quot;:[0],&quot;stat&quot;:[0],&quot;statLabel&quot;:[0],&quot;statLabelRichText&quot;:[0],&quot;bodyRichText&quot;:[0],&quot;color&quot;:[0],&quot;quote&quot;:[0],&quot;relationTo&quot;:[0,&quot;marketingEntityPeople&quot;],&quot;productSize&quot;:[0],&quot;fullWidth&quot;:[0,false],&quot;unsupportedReason&quot;:[0],&quot;key&quot;:[0,&quot;62kHgrueXl8R2Bue8lXIJC&quot;]}],[0,{&quot;cardType&quot;:[0,&quot;leadership&quot;],&quot;heading&quot;:[0,&quot;Chirag Chheda&quot;],&quot;body&quot;:[0,&quot;Chirag Chheda is the Chief Technology Officer at Calendly, where he leads the company’s technology strategy and drives innovation across engineering, AI, platform, and product infrastructure. He is passionate about building intelligent, scalable systems that enhance how millions of people schedule, connect, and collaborate every day.\n\nBefore Calendly, he managed the research and development organization at Shiftsmart as the Head of Product and Engineering. There he scaled the team to support product innovations and architecture overhauls spanning dynamic bonuses and incentives, instant payments, AI-led support, and automated robocalling. Prior to that, he was the Vice President of Engineering at ClickUp, where he led all of their product engineering efforts, including rearchitecting the company’s AI-powered productivity platform. He also served as the Senior Director of Engineering at Lyft through its IPO, where he led a global team of engineers to drive adoption of the company’s AI and machine learning-supported products. Earlier on in his career, he held senior management and software development positions at Facebook, now Meta, and Amazon.\n\nChirag holds a B. Tech in Information Technology from the Indian Institute of Information Technology.&quot;],&quot;badge&quot;:[0,&quot;Chief Technology Officer&quot;],&quot;href&quot;:[0],&quot;ctaLabel&quot;:[0],&quot;imageSrc&quot;:[0,&quot;https://cdn.calendlycms.com/chirag-headshot.png&quot;],&quot;imageAlt&quot;:[0,&quot;&quot;],&quot;videoHashedId&quot;:[0],&quot;videoAspectRatio&quot;:[0],&quot;iconSrc&quot;:[0],&quot;iconSrcs&quot;:[0],&quot;listItems&quot;:[1,[]],&quot;listIcon&quot;:[0],&quot;linkedInHref&quot;:[0,&quot;https://www.linkedin.com/in/chirag-chheda/&quot;],&quot;logoSrc&quot;:[0],&quot;logoAlt&quot;:[0],&quot;stat&quot;:[0],&quot;statLabel&quot;:[0],&quot;statLabelRichText&quot;:[0],&quot;bodyRichText&quot;:[0],&quot;color&quot;:[0],&quot;quote&quot;:[0],&quot;relationTo&quot;:[0,&quot;marketingEntityPeople&quot;],&quot;productSize&quot;:[0],&quot;fullWidth&quot;:[0,false],&quot;unsupportedReason&quot;:[0],&quot;key&quot;:[0,&quot;1QeQ2cNG68zu4Yhltp7Fgq&quot;]}]]],&quot;logo&quot;:[0],&quot;desktopColumnCount&quot;:[0,2],&quot;tabletColumnCount&quot;:[0,1],&quot;singleColumn&quot;:[0],&quot;eager&quot;:[0,false],&quot;locale&quot;:[0,&quot;en-US&quot;],&quot;leadershipCardLabels&quot;:[0,{&quot;moreAbout&quot;:[0,&quot;More about&quot;],&quot;lessAbout&quot;:[0,&quot;Less about&quot;],&quot;viewLinkedInProfile&quot;:[0,&quot;View {name}'s LinkedIn profile&quot;],&quot;leadershipTeamMember&quot;:[0,&quot;leadership team member&quot;],&quot;expandLeader&quot;:[0,&quot;Expand {name}&quot;],&quot;collapseLeader&quot;:[0,&quot;Collapse {name}&quot;]}],&quot;layout&quot;:[0],&quot;marqueeLabels&quot;:[0,{&quot;pauseScrolling&quot;:[0,&quot;Pause scrolling&quot;],&quot;resumeScrolling&quot;:[0,&quot;Resume scrolling&quot;]}],&quot;sectionLabel&quot;:[0],&quot;testId&quot;:[0,&quot;section-card-grid&quot;]}" ssr="" client="visible" opts="{&quot;name&quot;:&quot;CardGrid&quot;,&quot;value&quot;:true}" await-children=""><div data-testid="section-card-grid" style="opacity:0;transform:translateY(25px)"><div data-testid="card-grid" class="relative w-full"><div data-testid="card-grid-content" class="relative z-10 flex flex-col gap-2xl ui-tb:gap-3xl items-center"><div data-testid="card-grid-items-cards" class="grid w-full items-stretch gap-lg grid-cols-1 ui-tb:grid-cols-1 ui-sdsk:grid-cols-2 ui-dsk:grid-cols-2 relative z-10"><div data-testid="component-grid-item" class="flex h-full"><article data-testid="leadership-card" class="relative w-full min-w-[276px] overflow-hidden rounded-ui-xl bg-linen p-md"><div class="relative flex h-full w-full flex-col gap-md overflow-hidden rounded-ui-lg"><div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 flex flex-col justify-end p-md pb-0 h-[134px] ui-sdsk:h-[262px]"><div class="pointer-events-auto bg-linen pb-md"><button type="button" aria-expanded="false" aria-label="Expand Tope Awotona" class="inline-flex items-center gap-xs self-start rounded-ui-sm bg-transparent py-xs type-body-md font-geist font-medium text-midnight outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border">More about<!-- --> <!-- -->Tope<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-plus size-5" aria-hidden="true"><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path></svg></button></div></div><div data-testid="leadership-card-image" class="inset-x-0 top-0 aspect-[556/411] w-full shrink-0 overflow-hidden rounded-ui-lg motion-safe:transition-transform motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none"><img src="https://cdn.calendlycms.com/tope-headshot.png" alt="" width="556" height="411" loading="lazy" decoding="async" class="h-full w-full object-cover"></div><div aria-hidden="true" class="h-[134px] shrink-0 ui-sdsk:h-[262px]"></div><div data-testid="leadership-card-content" class="absolute inset-x-0 z-20 flex flex-col gap-sm p-md pb-0 bg-linen motion-safe:transition-[top] motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none top-[calc(100%-134px)] ui-sdsk:top-[calc(100%-262px)] h-0 ui-sdsk:h-[204px]"><div class="flex w-full items-start gap-md"><div class="flex min-w-0 flex-1 flex-col gap-xs"><h4 class="type-h4 font-wulkan font-medium leading-[1.2] text-midnight [word-break:break-word]">Tope Awotona</h4><p class="type-h6 font-calendly-sans font-normal leading-[1.4] text-midnight [word-break:break-word]">Founder, Chief Executive Officer</p></div><a href="https://www.linkedin.com/in/bawotona/" target="_blank" rel="noopener noreferrer" aria-label="View Tope Awotona's LinkedIn profile" class="pointer-events-auto relative z-40 flex size-[34px] shrink-0 items-center justify-center rounded-ui-sm border-[1.5px] border-midnight-a20 bg-midnight-a05 text-midnight ui-tb:size-12 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border"><svg class="size-4 ui-tb:size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none"><g clip-path="url(#clip0_2437_1041)"><path d="M22.2234 0H1.77187C0.792187 0 0 0.773438 0 1.72969V22.2656C0 23.2219 0.792187 24 1.77187 24H22.2234C23.2031 24 24 23.2219 24 22.2703V1.72969C24 0.773438 23.2031 0 22.2234 0ZM7.12031 20.4516H3.55781V8.99531H7.12031V20.4516ZM5.33906 7.43438C4.19531 7.43438 3.27188 6.51094 3.27188 5.37187C3.27188 4.23281 4.19531 3.30937 5.33906 3.30937C6.47813 3.30937 7.40156 4.23281 7.40156 5.37187C7.40156 6.50625 6.47813 7.43438 5.33906 7.43438ZM20.4516 20.4516H16.8937V14.8828C16.8937 13.5562 16.8703 11.8453 15.0422 11.8453C13.1906 11.8453 12.9094 13.2937 12.9094 14.7891V20.4516H9.35625V8.99531H12.7687V10.5609H12.8156C13.2891 9.66094 14.4516 8.70938 16.1813 8.70938C19.7859 8.70938 20.4516 11.0813 20.4516 14.1656V20.4516Z" fill="currentColor"></path></g><defs><clipPath id="clip0_2437_1041"><rect width="24" height="24" fill="currentColor"></rect></clipPath></defs></svg></a></div><div class="relative h-full overflow-hidden"><p class="type-body-md font-geist leading-[1.4] text-text-secondary whitespace-pre-line">Tope Awotona is the founder and CEO of Calendly, the scheduling platform that enables individuals, teams, and organizations globally to automate meetings – helping companies close deals, hire candidates, build relationships, and grow their business faster. He founded Calendly in 2013 with the vision of simplifying scheduling for everyone without the back-and-forth emails. With Tope’s strategic direction, the platform has grown and evolved to over 20 million users.

Prior to Calendly, Tope spent the majority of his career in enterprise software sales, working for companies such as IBM, Perceptive Software, and Dell Technologies, in addition to launching a series of startups. He grew up in Lagos, Nigeria and came to the United States in 1996.

Tope holds a degree in Management Information Systems from the University of Georgia.</p><div aria-hidden="false" class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[64px] bg-linear-to-b from-linen/0 from-0% to-linen to-[115%] motion-safe:transition-opacity motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none block"></div></div></div></div></article></div><div data-testid="component-grid-item" class="flex h-full"><article data-testid="leadership-card" class="relative w-full min-w-[276px] overflow-hidden rounded-ui-xl bg-linen p-md"><div class="relative flex h-full w-full flex-col gap-md overflow-hidden rounded-ui-lg"><div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 flex flex-col justify-end p-md pb-0 h-[134px] ui-sdsk:h-[262px]"><div class="pointer-events-auto bg-linen pb-md"><button type="button" aria-expanded="false" aria-label="Expand Shane Murphy-Reuter" class="inline-flex items-center gap-xs self-start rounded-ui-sm bg-transparent py-xs type-body-md font-geist font-medium text-midnight outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border">More about<!-- --> <!-- -->Shane<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-plus size-5" aria-hidden="true"><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path></svg></button></div></div><div data-testid="leadership-card-image" class="inset-x-0 top-0 aspect-[556/411] w-full shrink-0 overflow-hidden rounded-ui-lg motion-safe:transition-transform motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none"><img src="https://cdn.calendlycms.com/shane-headshot.png" alt="" width="556" height="411" loading="lazy" decoding="async" class="h-full w-full object-cover"></div><div aria-hidden="true" class="h-[134px] shrink-0 ui-sdsk:h-[262px]"></div><div data-testid="leadership-card-content" class="absolute inset-x-0 z-20 flex flex-col gap-sm p-md pb-0 bg-linen motion-safe:transition-[top] motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none top-[calc(100%-134px)] ui-sdsk:top-[calc(100%-262px)] h-0 ui-sdsk:h-[204px]"><div class="flex w-full items-start gap-md"><div class="flex min-w-0 flex-1 flex-col gap-xs"><h4 class="type-h4 font-wulkan font-medium leading-[1.2] text-midnight [word-break:break-word]">Shane Murphy-Reuter</h4><p class="type-h6 font-calendly-sans font-normal leading-[1.4] text-midnight [word-break:break-word]">President of Go-to-Market</p></div><a href="https://www.linkedin.com/in/shanemurfy/" target="_blank" rel="noopener noreferrer" aria-label="View Shane Murphy-Reuter's LinkedIn profile" class="pointer-events-auto relative z-40 flex size-[34px] shrink-0 items-center justify-center rounded-ui-sm border-[1.5px] border-midnight-a20 bg-midnight-a05 text-midnight ui-tb:size-12 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border"><svg class="size-4 ui-tb:size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none"><g clip-path="url(#clip0_2437_1041)"><path d="M22.2234 0H1.77187C0.792187 0 0 0.773438 0 1.72969V22.2656C0 23.2219 0.792187 24 1.77187 24H22.2234C23.2031 24 24 23.2219 24 22.2703V1.72969C24 0.773438 23.2031 0 22.2234 0ZM7.12031 20.4516H3.55781V8.99531H7.12031V20.4516ZM5.33906 7.43438C4.19531 7.43438 3.27188 6.51094 3.27188 5.37187C3.27188 4.23281 4.19531 3.30937 5.33906 3.30937C6.47813 3.30937 7.40156 4.23281 7.40156 5.37187C7.40156 6.50625 6.47813 7.43438 5.33906 7.43438ZM20.4516 20.4516H16.8937V14.8828C16.8937 13.5562 16.8703 11.8453 15.0422 11.8453C13.1906 11.8453 12.9094 13.2937 12.9094 14.7891V20.4516H9.35625V8.99531H12.7687V10.5609H12.8156C13.2891 9.66094 14.4516 8.70938 16.1813 8.70938C19.7859 8.70938 20.4516 11.0813 20.4516 14.1656V20.4516Z" fill="currentColor"></path></g><defs><clipPath id="clip0_2437_1041"><rect width="24" height="24" fill="currentColor"></rect></clipPath></defs></svg></a></div><div class="relative h-full overflow-hidden"><p class="type-body-md font-geist leading-[1.4] text-text-secondary whitespace-pre-line">Shane Murphy-Reuter is the President of Go-to-Market at Calendly, leading the Sales, Marketing, and Customer Support teams. He's focused on driving brand awareness and demand by ensuring alignment between sales strategies, marketing initiatives, and customer experience.

A B2B software veteran, Shane is an expert at data-driven decision-making and harmonizing product- and sales-led growth strategies to drive scalable growth. Previously he was the CMO at Webflow, where he established and scaled the company's marketing function and led their self-serve business, including product marketing, brand, enterprise demand generation, partner channels, and pricing. Before that, he was the CMO of ZoomInfo, where he helped the company grow to over $1 billion in revenue. He also served as SVP of Marketing at Intercom and VP of Sales and Marketing at AdRoll.

Shane currently serves on the board of Stockpress, as a limited partner at Stage 2 Capital, and as an advisor to multiple SaaS companies. He holds a Bachelor of Business &amp; Law from the University College Dublin.</p><div aria-hidden="false" class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[64px] bg-linear-to-b from-linen/0 from-0% to-linen to-[115%] motion-safe:transition-opacity motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none block"></div></div></div></div></article></div><div data-testid="component-grid-item" class="flex h-full"><article data-testid="leadership-card" class="relative w-full min-w-[276px] overflow-hidden rounded-ui-xl bg-linen p-md"><div class="relative flex h-full w-full flex-col gap-md overflow-hidden rounded-ui-lg"><div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 flex flex-col justify-end p-md pb-0 h-[134px] ui-sdsk:h-[262px]"><div class="pointer-events-auto bg-linen pb-md"><button type="button" aria-expanded="false" aria-label="Expand Shahara Jasion" class="inline-flex items-center gap-xs self-start rounded-ui-sm bg-transparent py-xs type-body-md font-geist font-medium text-midnight outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border">More about<!-- --> <!-- -->Shahara<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-plus size-5" aria-hidden="true"><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path></svg></button></div></div><div data-testid="leadership-card-image" class="inset-x-0 top-0 aspect-[556/411] w-full shrink-0 overflow-hidden rounded-ui-lg motion-safe:transition-transform motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none"><img src="https://cdn.calendlycms.com/shahara-headshot.png" alt="" width="556" height="411" loading="lazy" decoding="async" class="h-full w-full object-cover"></div><div aria-hidden="true" class="h-[134px] shrink-0 ui-sdsk:h-[262px]"></div><div data-testid="leadership-card-content" class="absolute inset-x-0 z-20 flex flex-col gap-sm p-md pb-0 bg-linen motion-safe:transition-[top] motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none top-[calc(100%-134px)] ui-sdsk:top-[calc(100%-262px)] h-0 ui-sdsk:h-[204px]"><div class="flex w-full items-start gap-md"><div class="flex min-w-0 flex-1 flex-col gap-xs"><h4 class="type-h4 font-wulkan font-medium leading-[1.2] text-midnight [word-break:break-word]">Shahara Jasion</h4><p class="type-h6 font-calendly-sans font-normal leading-[1.4] text-midnight [word-break:break-word]">Chief Financial Officer</p></div><a href="https://www.linkedin.com/in/shahara-jasion-51764222/" target="_blank" rel="noopener noreferrer" aria-label="View Shahara Jasion's LinkedIn profile" class="pointer-events-auto relative z-40 flex size-[34px] shrink-0 items-center justify-center rounded-ui-sm border-[1.5px] border-midnight-a20 bg-midnight-a05 text-midnight ui-tb:size-12 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border"><svg class="size-4 ui-tb:size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none"><g clip-path="url(#clip0_2437_1041)"><path d="M22.2234 0H1.77187C0.792187 0 0 0.773438 0 1.72969V22.2656C0 23.2219 0.792187 24 1.77187 24H22.2234C23.2031 24 24 23.2219 24 22.2703V1.72969C24 0.773438 23.2031 0 22.2234 0ZM7.12031 20.4516H3.55781V8.99531H7.12031V20.4516ZM5.33906 7.43438C4.19531 7.43438 3.27188 6.51094 3.27188 5.37187C3.27188 4.23281 4.19531 3.30937 5.33906 3.30937C6.47813 3.30937 7.40156 4.23281 7.40156 5.37187C7.40156 6.50625 6.47813 7.43438 5.33906 7.43438ZM20.4516 20.4516H16.8937V14.8828C16.8937 13.5562 16.8703 11.8453 15.0422 11.8453C13.1906 11.8453 12.9094 13.2937 12.9094 14.7891V20.4516H9.35625V8.99531H12.7687V10.5609H12.8156C13.2891 9.66094 14.4516 8.70938 16.1813 8.70938C19.7859 8.70938 20.4516 11.0813 20.4516 14.1656V20.4516Z" fill="currentColor"></path></g><defs><clipPath id="clip0_2437_1041"><rect width="24" height="24" fill="currentColor"></rect></clipPath></defs></svg></a></div><div class="relative h-full overflow-hidden"><p class="type-body-md font-geist leading-[1.4] text-text-secondary whitespace-pre-line">Shahara Jasion is the CFO at Calendly, where she leads the Finance, Legal, and IT/Systems functions to ensure business excellence and strategic alignment across the organization.

She has held financial positions at high-growth technology and advisory companies for more than 15 years. Most recently the VP of Finance, Shahara has been instrumental in shaping Calendly’s financial strategy since she joined the company in 2023. Previously, she was the VP of Finance at the global sales enablement software company Seismic, where she also served as the interim CFO and supported the organization through multiple acquisitions and financing rounds. Before that, Shahara spent nearly eight years at Deloitte as a Senior Audit Manager. She began her career working in various accounting and assurance positions at Life Technologies, now part of Thermo Fisher Scientific; public sector software company TriTech Software System, now CentralSquare; and PwC.

Shahara holds a Bachelor of Arts in Accountancy from Villanova University.</p><div aria-hidden="false" class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[64px] bg-linear-to-b from-linen/0 from-0% to-linen to-[115%] motion-safe:transition-opacity motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none block"></div></div></div></div></article></div><div data-testid="component-grid-item" class="flex h-full"><article data-testid="leadership-card" class="relative w-full min-w-[276px] overflow-hidden rounded-ui-xl bg-linen p-md"><div class="relative flex h-full w-full flex-col gap-md overflow-hidden rounded-ui-lg"><div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 flex flex-col justify-end p-md pb-0 h-[134px] ui-sdsk:h-[262px]"><div class="pointer-events-auto bg-linen pb-md"><button type="button" aria-expanded="false" aria-label="Expand Chirag Chheda" class="inline-flex items-center gap-xs self-start rounded-ui-sm bg-transparent py-xs type-body-md font-geist font-medium text-midnight outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border">More about<!-- --> <!-- -->Chirag<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-plus size-5" aria-hidden="true"><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path></svg></button></div></div><div data-testid="leadership-card-image" class="inset-x-0 top-0 aspect-[556/411] w-full shrink-0 overflow-hidden rounded-ui-lg motion-safe:transition-transform motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none"><img src="https://cdn.calendlycms.com/chirag-headshot.png" alt="" width="556" height="411" loading="lazy" decoding="async" class="h-full w-full object-cover"></div><div aria-hidden="true" class="h-[134px] shrink-0 ui-sdsk:h-[262px]"></div><div data-testid="leadership-card-content" class="absolute inset-x-0 z-20 flex flex-col gap-sm p-md pb-0 bg-linen motion-safe:transition-[top] motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none top-[calc(100%-134px)] ui-sdsk:top-[calc(100%-262px)] h-0 ui-sdsk:h-[204px]"><div class="flex w-full items-start gap-md"><div class="flex min-w-0 flex-1 flex-col gap-xs"><h4 class="type-h4 font-wulkan font-medium leading-[1.2] text-midnight [word-break:break-word]">Chirag Chheda</h4><p class="type-h6 font-calendly-sans font-normal leading-[1.4] text-midnight [word-break:break-word]">Chief Technology Officer</p></div><a href="https://www.linkedin.com/in/chirag-chheda/" target="_blank" rel="noopener noreferrer" aria-label="View Chirag Chheda's LinkedIn profile" class="pointer-events-auto relative z-40 flex size-[34px] shrink-0 items-center justify-center rounded-ui-sm border-[1.5px] border-midnight-a20 bg-midnight-a05 text-midnight ui-tb:size-12 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-action-focus-border"><svg class="size-4 ui-tb:size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none"><g clip-path="url(#clip0_2437_1041)"><path d="M22.2234 0H1.77187C0.792187 0 0 0.773438 0 1.72969V22.2656C0 23.2219 0.792187 24 1.77187 24H22.2234C23.2031 24 24 23.2219 24 22.2703V1.72969C24 0.773438 23.2031 0 22.2234 0ZM7.12031 20.4516H3.55781V8.99531H7.12031V20.4516ZM5.33906 7.43438C4.19531 7.43438 3.27188 6.51094 3.27188 5.37187C3.27188 4.23281 4.19531 3.30937 5.33906 3.30937C6.47813 3.30937 7.40156 4.23281 7.40156 5.37187C7.40156 6.50625 6.47813 7.43438 5.33906 7.43438ZM20.4516 20.4516H16.8937V14.8828C16.8937 13.5562 16.8703 11.8453 15.0422 11.8453C13.1906 11.8453 12.9094 13.2937 12.9094 14.7891V20.4516H9.35625V8.99531H12.7687V10.5609H12.8156C13.2891 9.66094 14.4516 8.70938 16.1813 8.70938C19.7859 8.70938 20.4516 11.0813 20.4516 14.1656V20.4516Z" fill="currentColor"></path></g><defs><clipPath id="clip0_2437_1041"><rect width="24" height="24" fill="currentColor"></rect></clipPath></defs></svg></a></div><div class="relative h-full overflow-hidden"><p class="type-body-md font-geist leading-[1.4] text-text-secondary whitespace-pre-line">Chirag Chheda is the Chief Technology Officer at Calendly, where he leads the company’s technology strategy and drives innovation across engineering, AI, platform, and product infrastructure. He is passionate about building intelligent, scalable systems that enhance how millions of people schedule, connect, and collaborate every day.

Before Calendly, he managed the research and development organization at Shiftsmart as the Head of Product and Engineering. There he scaled the team to support product innovations and architecture overhauls spanning dynamic bonuses and incentives, instant payments, AI-led support, and automated robocalling. Prior to that, he was the Vice President of Engineering at ClickUp, where he led all of their product engineering efforts, including rearchitecting the company’s AI-powered productivity platform. He also served as the Senior Director of Engineering at Lyft through its IPO, where he led a global team of engineers to drive adoption of the company’s AI and machine learning-supported products. Earlier on in his career, he held senior management and software development positions at Facebook, now Meta, and Amazon.

Chirag holds a B. Tech in Information Technology from the Indian Institute of Information Technology.</p><div aria-hidden="false" class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[64px] bg-linear-to-b from-linen/0 from-0% to-linen to-[115%] motion-safe:transition-opacity motion-safe:duration-[700ms] motion-safe:ease-[cubic-bezier(0.34,1.45,0.64,1)] motion-reduce:transition-none block"></div></div></div></div></article></div></div></div></div></div></astro-island></div></section><section id="[About]-Testimonial" class="flex w-full justify-center bg-surface-bg-primary py-section-default"><div class="z-10 has-data-scrolljack-overlay:z-1001 w-full flex flex-col @container gap-2xl max-w-[1280px] px-(--section-padding-x)"><astro-island uid="ZnMomx" prefix="r23" component-url="/_astro/index.CmO4VxXq.js" component-export="TestimonialStoryIsland" renderer-url="/_astro/client.DSHm9q9k.js" props="{&quot;items&quot;:[1,[[0,{&quot;logo&quot;:[0,&quot;https://cdn.calendlycms.com/achievement-first-customer-logo.svg&quot;],&quot;logoAlt&quot;:[0,&quot;Achievement First&quot;],&quot;quote&quot;:[0,&quot;\&quot;Calendly helps us protect our team’s time and make every support interaction count.\&quot;&quot;],&quot;authorName&quot;:[0,&quot;Marques Stewart&quot;],&quot;authorRole&quot;:[0,&quot;Managing Director of Technology at Achievement First&quot;],&quot;authorImage&quot;:[0,&quot;https://cdn.calendlycms.com/MarquesStewart.png&quot;],&quot;authorImageAlt&quot;:[0,&quot;Marques Stewart&quot;],&quot;ctaLabel&quot;:[0,&quot;Read customer story&quot;],&quot;href&quot;:[0,&quot;/customers/achievement-first&quot;]}],[0,{&quot;logo&quot;:[0,&quot;https://cdn.calendlycms.com/time-coaching-and-speaking-customer-logo.svg&quot;],&quot;logoAlt&quot;:[0,&quot;Real Life E&quot;],&quot;quote&quot;:[0,&quot;\&quot;Adding a booking fee didn’t just reduce no-shows — it changed the tone of my consultations.\&quot;&quot;],&quot;authorName&quot;:[0,&quot;Elizabeth Saunders&quot;],&quot;au