            /* PREFERENCE CENTER */
div#onetrust-pc-sdk #accept-recommended-btn-handler,
div#onetrust-pc-sdk .ot-pc-refuse-all-handler,
div#onetrust-pc-sdk .save-preference-btn-handler {
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 0.875rem;
    line-height: 1.4;
    font-weight: 600 !important;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease !important;
}

div#onetrust-pc-sdk #accept-recommended-btn-handler:hover,
div#onetrust-pc-sdk #accept-recommended-btn-handler:focus,
div#onetrust-pc-sdk #accept-recommended-btn-handler:active,
div#onetrust-pc-sdk .ot-pc-refuse-all-handler:hover,
div#onetrust-pc-sdk .ot-pc-refuse-all-handler:focus,
div#onetrust-pc-sdk .ot-pc-refuse-all-handler:active,
div#onetrust-pc-sdk .save-preference-btn-handler:hover,
div#onetrust-pc-sdk .save-preference-btn-handler:focus,
div#onetrust-pc-sdk .save-preference-btn-handler:active {
    background-color: #0e396a !important;
    color: #fcfbf8 !important;
    border-color: #0e396a !important;
    opacity: 1 !important;
}

div#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob {
    background-color: #0e396a; /* --color-navy */
}
div#onetrust-pc-sdk .ot-switch-nob:before {
    height: 19px;
    width: 19px;
    bottom: 2px;
    left: 2px;
}
div#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before {
    transform: translateX(20px);
}
div#onetrust-pc-sdk .ot-accordion-layout .ot-cat-header {
    min-height: auto !important;
}
div#onetrust-pc-sdk .ot-plus-minus span {
    background: #476788 !important; /* no rebrand equiv, neutral grey kept */
}
div#onetrust-pc-sdk #ot-pc-title,
div#onetrust-pc-sdk #ot-category-title {
    color: #071a31 !important; /* --color-midnight */
}
div#onetrust-pc-sdk .ot-cat-header {
    color: #0e396a !important; /* --color-navy */
}
div#onetrust-pc-sdk .ot-pc-footer-logo {
    padding-right: 25px;
}
div#onetrust-pc-sdk .ot-pc-footer-logo a {
    height: 20px;
    margin-right: 0;
    width: fit-content;
}
div#onetrust-pc-sdk .ot-pc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 25px;
}
div#onetrust-pc-sdk .ot-pc-logo {
    width: fit-content;
}
div#onetrust-pc-sdk .ot-pc-logo img {
    max-height: 24px !important;
    width: auto !important;
}

/* Close (X) button — same treatment as banner */
div#onetrust-pc-sdk #close-pc-btn-handler {
    width: 32px !important;
    height: 32px !important;
    margin-right: 0 !important;
    background-color: #071a310d !important;
    border: 1px solid #071a3133 !important;
    border-radius: 8px !important;
    background-image: url("data:image/svg+xml;base64,") !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    background-size: 16px 16px !important;
    cursor: pointer !important;
    padding: 0 !important;
}

div#onetrust-pc-sdk #close-pc-btn-handler svg {
    display: none !important;
}

div#onetrust-pc-sdk #ot-pc-content {
    margin: 0;
    padding: 0 19px 0 25px;
    width: auto;
    overflow-y: scroll;
}
div#onetrust-pc-sdk .ot-pc-scrollbar::-webkit-scrollbar-thumb {
    border-radius: 8px !important;
}
#onetrust-pc-sdk .ot-pc-scrollbar::-webkit-scrollbar {
    width: 6px !important;
}

/* TABLET*/
@media only screen and (min-width: 567px) and (max-width: 900px) {
    div.ot-sdk-row {
        flex-direction: column !important;
    }
}

/* MOBILE */
@media only screen and (max-width: 567px) {
    div.ot-sdk-row {
        flex-direction: column !important;
    }
    div#onetrust-button-group {
        flex-direction: column-reverse;
        width: 100% !important;
    }
    div#onetrust-accept-btn-handler {
        text-align: center;
    }
    #onetrust-pc-sdk div#onetrust-button-group {
        width: unset !important;
    }
}

#onetrust-pc-sdk .ot-always-active {
    color: #0e396a !important; /* --color-navy */
