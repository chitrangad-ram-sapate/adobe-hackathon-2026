                    margin-left: 5px;
                }div#onetrust-banner-sdk {
    box-sizing: border-box !important;
    background-color: #ffffff !important;
    border: 1px solid #d8dce0 !important;
    border-radius: 16px !important;
    box-shadow:
        0 1px 2px 0 #4767880A,
        0 4px 8px 0 #47678808,
        0 12px 24px 0 #47678814 !important;
    padding: 24px !important;
    max-width: 570px !important;
    font-family: inherit !important;
}

div#onetrust-banner-sdk .ot-sdk-container,
div#onetrust-banner-sdk .ot-sdk-row {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
}

div#onetrust-banner-sdk .ot-sdk-row:after {
    display: none !important;
}

div#onetrust-banner-sdk .ot-sdk-columns,
div#onetrust-banner-sdk .ot-sdk-twelve,
div#onetrust-banner-sdk .ot-sdk-nine,
div#onetrust-banner-sdk .ot-sdk-three,
div#onetrust-banner-sdk .ot-sdk-eight,
div#onetrust-banner-sdk .ot-sdk-four {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
}

div#onetrust-banner-sdk #onetrust-group-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
    position: relative !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
}

div#onetrust-banner-sdk #onetrust-policy {
    margin: 0 !important;
    padding: 0 !important;
}

div#onetrust-banner-sdk #onetrust-policy-title {
    color: #071a31 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1.4 !important;
    margin: 0 0 8px 0 !important;
    padding: 0 48px 0 0 !important;
}

div#onetrust-banner-sdk #onetrust-policy-text {
    color: #5f6d77 !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    margin: 0 !important;
    padding: 0 48px 16px 0 !important;
    overflow-wrap: break-word;
}

div#onetrust-banner-sdk #onetrust-policy-text a {
    color: #5f6d77 !important;
    font-weight: 400 !important;
    text-decoration: underline !important;
    margin-left: 0 !important;
}

div#onetrust-banner-sdk #onetrust-button-group-parent {
    position: relative !important;
    transform: none !important;
    top: auto !important;
    left: auto !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
}

div#onetrust-banner-sdk #onetrust-button-group {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 16px !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
}

div#onetrust-banner-sdk #onetrust-button-group .onetrust-banner-options {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 16px !important;
    order: 1 !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
    max-width: none !important;
    width: auto !important;
}

div#onetrust-banner-sdk #onetrust-button-group button {
    flex: 0 0 auto !important;
    min-width: 0 !important;
    width: auto !important;
    margin: 0 !important;
    padding: 8px 12px !important;
    min-height: 0 !important;
    height: auto !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1.4 !important;
    border-radius: 8px !important;
    border-width: 1px !important;
    border-style: solid !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease !important;
}

div#onetrust-banner-sdk #onetrust-reject-all-handler {
    background-color: transparent !important;
    color: #071a31 !important;
    border-color: #071a31 !important;
    order: 1 !important;
}

div#onetrust-banner-sdk #onetrust-reject-all-handler:hover,
div#onetrust-banner-sdk #onetrust-reject-all-handler:focus,
div#onetrust-banner-sdk #onetrust-reject-all-handler:active {
    background-color: #071a31 !important;
    color: #fcfbf8 !important;
    border-color: #071a31 !important;
}

div#onetrust-banner-sdk #onetrust-accept-btn-handler {
    background-color: #071a31 !important;
    color: #fcfbf8 !important;
    border-color: #071a31 !important;
    order: 2 !important;
}

div#onetrust-banner-sdk #onetrust-accept-btn-handler:hover,
div#onetrust-banner-sdk #onetrust-accept-btn-handler:focus,
div#onetrust-banner-sdk #onetrust-accept-btn-handler:active {
    background-color: #0e396a !important;
    color: #fcfbf8 !important;
    border-color: #0e396a !important;
}

div#onetrust-banner-sdk .cookie-setting-link,
div#onetrust-banner-sdk button.cookie-setting-link,
div#onetrust-banner-sdk a.cookie-setting-link,
div#onetrust-banner-sdk .ot-link-btn,
div#onetrust-banner-sdk #onetrust-pc-btn-handler,
div#onetrust-banner-sdk #onetrust-pc-btn-handler.cookie-setting-link,
div#onetrust-banner-sdk .cookie-setting-link:hover,
div#onetrust-banner-sdk .cookie-setting-link:focus,
div#onetrust-banner-sdk .cookie-setting-link:active,
div#onetrust-banner-sdk #onetrust-pc-btn-handler:hover,
div#onetrust-banner-sdk #onetrust-pc-btn-handler:focus,
div#onetrust-banner-sdk #onetrust-pc-btn-handler:active {
    border: 0 !important;
    border-width: 0 !important;
    border-style: none !important;
    box-shadow: none !important;
    background: transparent !important;
    background-color: transparent !important;
}

div#onetrust-banner-sdk .cookie-setting-link {
    order: 99 !important;
    margin-left: auto !important;
    margin-right: 0 !important;
    padding: 8px 0 8px 0 !important;
    color: #071a31 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1.4 !important;
    text-decoration: none !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    transition: opacity 0.15s ease !important;
}

div#onetrust-banner-sdk .cookie-setting-link:hover {
    opacity: 0.8 !important;
}

div#onetrust-banner-sdk .cookie-setting-link:focus-visible,
div#onetrust-banner-sdk #onetrust-pc-btn-handler:focus-visible {
    outline: 1px solid #071a31 !important;
    outline-offset: -8px !important;
}

div#onetrust-banner-sdk .cookie-setting-link::after {
    content: "" !important;
    display: inline-block !important;
    width: 16px !important;
    height: 16px !important;
    background-image: url("data:image/svg+xml;base64,") !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    background-size: 16px 16px !important;
    transition: transform 0.15s linear !important;
}

div#onetrust-banner-sdk .cookie-setting-link:hover::after {
    transform: translateX(4px) !important;
}

div#onetrust-banner-sdk #onetrust-close-btn-container {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    bottom: auto !important;
    left: auto !important;
    width: 32px !important;
    height: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
}

div#onetrust-banner-sdk .banner-close-button {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    bottom: auto !important;
    left: auto !important;
    width: 32px !important;
    height: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
}

div#onetrust-banner-sdk .ot-close-icon,
div#onetrust-banner-sdk #onetrust-close-btn-container button {
    width: 32px !important;
    height: 32px !important;
    background-color: #071a310d !important;
    border: 1px solid #071a3133 !important;
    border-radius: 8px !important;
    background-image: url("data:image/svg+xml;base64,") !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    background-size: 16px 16px !important;
    cursor: pointer !important;
    padding: 0 !important;
}

@media screen and (max-width: 992px) {
    div#onetrust-banner-sdk {
        max-width: 700px !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
    }
}

@media screen and (max-width: 480px) {
    div#onetrust-banner-sdk {
        left: 24px !important;
        right: 24px !important;
        bottom: 24px !important;
        transform: none !important;
        width: auto !important;
        min-width: auto !important;
        padding: 16px !important;
        border-radius: 12px !important;
    }

    div#onetrust-banner-sdk #onetrust-policy-title,
    div#onetrust-banner-sdk #onetrust-policy-text {
        padding-right: 40px !important;
    }

    div#onetrust-banner-sdk #onetrust-button-group-parent #onetrust-button-group {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 8px !important;
    }

    div#onetrust-banner-sdk #onetrust-button-group .onetrust-banner-options {
        display: flex !important;
        flex-direction: row !important;
        gap: 8px !important;
        width: 100% !important;
        max-width: none !important;
    }

    div#onetrust-banner-sdk #onetrust-button-group .onetrust-banner-options button {
        flex: 1 1 0 !important;
        min-width: 0 !important;
        width: auto !important;
    }

    div#onetrust-banner-sdk #onetrust-button-group-parent .cookie-setting-link {
        order: 0 !important;
        margin-left: 0 !important;
        justify-content: center !important;
    }

    div#onetrust-banner-sdk #onetrust-button-group-parent .cookie-setting-link {
        width: fit-content !important;
        align-self: center !important;
        margin: 0 auto !important;
    }
