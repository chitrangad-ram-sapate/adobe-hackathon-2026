smissed [data-gab-id="15"]{display:none!important}</style><script>(function(){const bannerId = "15";

  try {
  	const hidden = JSON.parse(localStorage.getItem('hidden-global-banners') || '[]');
  	if (Array.isArray(hidden) && hidden.indexOf(bannerId) !== -1) {
  		document.documentElement.classList.add('gab-dismissed');
  	}
  } catch {
  	// localStorage unavailable (rare: storage fully disabled): no-op, banner stays visible.
  	// Dismissal persistence just won't work for this session.
  }
})();</script><script>(function(){const mockLoginQueryParam = "simulateLogin";
const mockLoginSessionKey = "CALENDLY_SIMULATED_LOGIN";
const productionHostnames = ["calendly.com","www.calendly.com"];

	(function () {
		const KEY = 'CALENDLY_AUTHENTICATED_USER_STATUS';
		const hostname = window.location.hostname.toLowerCase().replace(/\.$/, '');
		const mockLoginAllowed = !productionHostnames.includes(hostname);
		const queryValue = new URLSearchParams(window.location.search).get(mockLoginQueryParam);
		let simulatedLogin = false;

		try {
			if (mockLoginAllowed && queryValue === 'true') {
				window.sessionStorage.setItem(mockLoginSessionKey, 'true');
				simulatedLogin = true;
			} else if (mockLoginAllowed && queryValue === 'false') {
				window.sessionStorage.removeItem(mockLoginSessionKey);
			} else if (mockLoginAllowed) {
				simulatedLogin = window.sessionStorage.getItem(mockLoginSessionKey) === 'true';
			} else {
				window.sessionStorage.removeItem(mockLoginSessionKey);
			}
		} catch {
			// Session storage unavailable: the explicit query parameter still works for
			// the current page, but cannot persist beyond it.
			simulatedLogin = mockLoginAllowed && queryValue === 'true';
		}

		try {
			const match = document.cookie.match(new RegExp('(?:^|; )' + KEY + '=([^;]*)'));
			const cookieLoggedIn = match ? decodeURIComponent(match[1]) === 'true' : false;
			const isLoggedIn = simulatedLogin || cookieLoggedIn;

			// Also clears stale localStorage=true after logout (cookie gone).
			if (isLoggedIn) {
				window.localStorage.setItem(KEY, 'true');
			} else {
				window.localStorage.removeItem(KEY);
			}

			if (isLoggedIn) document.documentElement.classList.add('auth-in');
		} catch {
			// cookies/localStorage unavailable: no-op, logged-out CTAs stay visible.
		}
	})();
})();</script><astro-island uid="1z6TKI" prefix="r16" component-url="/_astro/index.CmO4VxXq.js" component-export="HeaderIsland" renderer-url="/_astro/client.DSHm9q9k.js" props="{&quot;locale&quot;:[0,&quot;en-US&quot;],&quot;ctaTalkToSales&quot;:[0,&quot;Talk to sales&quot;],&quot;ctaLogin&quot;:[0,&quot;Log In&quot;],&quot;ctaSignup&quot;:[0,&quot;Get started for free&quot;],&quot;ctaSignupShort&quot;:[0,&quot;Get started&quot;],&quot;ctaMyAccount&quot;:[0,&quot;My Account&quot;],&quot;announcementBanner&quot;:[0,{&quot;id&quot;:[0,&quot;15&quot;],&quot;heading&quot;:[0,&quot;Introducing the new Calendly, built to handle all of the work around meetings.&quot;],&quot;icon&quot;:[0,{&quot;icon&quot;:[0,&quot;IconSpeakerphone&quot;],&quot;alt&quot;:[0,&quot;&quot;]}],&quot;backgroundColor&quot;:[0,&quot;blue&quot;],&quot;linkLabel&quot;:[0,&quot;Learn more&quot;],&quot;linkHref&quot;:[0,&quot;/blog/new-calendly&quot;],&quot;targetGroup&quot;:[0,&quot;all&quot;],&quot;includeOn&quot;:[1,[[0,&quot;/**&quot;],[0,&quot;/legal&quot;]]],&quot;doNotShow&quot;:[1,[[0,&quot;/login&quot;],[0,&quot;/signup&quot;],[0,&quot;/landing&quot;],[0,&quot;/landing/**&quot;],[0,&quot;/contact&quot;],[0,&quot;/contact/**&quot;],[0,&quot;/blog&quot;],[0,&quot;/blog/**&quot;],[0,&quot;/newsroom&quot;],[0,&quot;/newsroom/**&quot;],[0,&quot;/integration/**&quot;],[0,&quot;/integration&quot;],[0,&quot;/solutions&quot;],[0,&quot;/solutions/**&quot;]]]}],&quot;menuLinks&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;97&quot;],&quot;label&quot;:[0,&quot;Products&quot;],&quot;link&quot;:[0,&quot;/features&quot;],&quot;submenu&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;210&quot;],&quot;label&quot;:[0,&quot;PRODUCTS&quot;],&quot;link&quot;:[0],&quot;submenu&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;212&quot;],&quot;label&quot;:[0,&quot;Scheduling&quot;],&quot;link&quot;:[0,&quot;/features/scheduling&quot;],&quot;submenu&quot;:[0]}],[0,{&quot;id&quot;:[0,&quot;220&quot;],&quot;label&quot;:[0,&quot;Notetaker&quot;],&quo