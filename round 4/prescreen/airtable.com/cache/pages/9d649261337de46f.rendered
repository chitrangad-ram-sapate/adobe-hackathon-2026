class="logos-module-scss-module__ASx_Sq__logoImage" src="https://cdn.sanity.io/images/hlcyrtq5/production/3a7ad9ad012531ee4048cabd68566dcea9b487a5-122x35.svg?w=336" data-airgap-id="7"></div></div></li></ul></div></section></div><div class="w-full min-w-0"><section data-slot="features" data-type="cards" class="features-module-scss-module__8-XBpW__root" data-block="card-grid" data-layout="default" data-default-variant="contentStack" data-content-stack-type="noMedia" data-variant="bkv3" aria-labelledby="features_R_13av5tep5b_-title"><div class="features-module-scss-module__8-XBpW__shell"><div class="features-module-scss-module__8-XBpW__titleBand"><div data-slot="title" class="title-module-scss-module__Gmh66W__root title-module-scss-module__Gmh66W__alignCenter features-module-scss-module__8-XBpW__title"><div class="title-module-scss-module__Gmh66W__textStack"><h2 id="features_R_13av5tep5b_-title" class="title-module-scss-module__Gmh66W__headline title-module-scss-module__Gmh66W__headlineSectionLarge">500,000 companies build in Airtable</h2></div></div></div><div class="features-module-scss-module__8-XBpW__bodyBand"><ul class="features-module-scss-module__8-XBpW__cardGrid"><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">50M+</h3><p class="features-module-scss-module__8-XBpW__cardBody">apps and agents</p></div></div></li><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">90%</h3><p class="features-module-scss-module__8-XBpW__cardBody">of the Fortune 100</p></div></div></li><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">10M</h3><p class="features-module-scss-module__8-XBpW__cardBody">active users</p></div></div></li></ul></div></div></section></div><div class="w-full min-w-0"><section data-slot="features" data-type="cards" class="features-module-scss-module__8-XBpW__root" data-block="card-grid" data-layout="default" data-default-variant="contentStack" data-content-stack-type="noMedia" data-variant="bkv3" aria-labelledby="features_R_1bav5tep5b_-title"><div class="features-module-scss-module__8-XBpW__shell"><div class="features-module-scss-module__8-XBpW__titleBand"><div data-slot="title" class="title-module-scss-module__Gmh66W__root title-module-scss-module__Gmh66W__alignCenter features-module-scss-module__8-XBpW__title"><div class="title-module-scss-module__Gmh66W__textStack"><h2 id="features_R_1bav5tep5b_-title" class="title-module-scss-module__Gmh66W__headline title-module-scss-module__Gmh66W__headlineSectionLarge">Here are some problems they're solving</h2></div></div></div><div class="features-module-scss-module__8-XBpW__bodyBand"><ul class="features-module-scss-module__8-XBpW__cardGrid"><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardIcon"><img src="https://cdn.sanity.io/images/hlcyrtq5/production/ab22b754cf9ab7c304c7a70622c824e022dbd6ce-57x57.svg" alt="Open AI logo" width="48" height="48"></div><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">Open AI</h3><p class="features-module-scss-module__8-XBpW__cardBody">Runs product operations in one shared system, surfacing risks before they slow a launch.</p></div></div></li><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardIcon"><img src="https://cdn.sanity.io/images/hlcyrtq5/production/52920ad66cca9b11a36949a60e508ad6075320d6-772x772.svg" alt="eBay logo" width="48" height="48"></div><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">eBay</h3><p class="features-module-scss-module__8-XBpW__cardBody">Processes customer feedback at scale to turn millions of signals into actionable insight.</p></div></div></li><li class="features-module-scss-module__8-XBpW__cardCell"><div class="features-module-scss-module__8-XBpW__cardCopy"><div class="features-module-scss-module__8-XBpW__cardIcon"><img src="https://cdn.sanity.io/images/hlcyrtq5/production/e51a982ba6d03a7fd7f5bc7d95051a41a8578815-167x30.svg" alt="West Elm logo" width="48" height="48"></div><div class="features-module-scss-module__8-XBpW__cardText"><h3 class="features-module-scss-module__8-XBpW__cardTitle">West Elm</h3><p class="features-module-scss-module__8-XBpW__cardBody">Manages seasons of creative work across every studio team in one shared system.</p></div></div></li></ul></div></div></section></div><div class="w-full min-w-0"><section data-slot="features" data-type="tabbers/small-media" class="features-module-scss-module__8-XBpW__root" data-block="tab-panels" data-variant="bkv3" aria-labelledby="features_R_1jav5tep5b_-title"><div class="features-module-scss-module__8-XBpW__shell"><div class="features-module-scss-module__8-XBpW__titleBand"><div data-slot="title" class="title-module-scss-module__Gmh66W__root title-module-scss-module__Gmh66W__alignCenter features-module-scss-module__8-XBpW__title"><div class="title-module-scss-module__Gmh66W__textStack"><span data-slot="badge" class="badge-module-scss-module__zEKSjq__root badge-module-scss-module__zEKSjq__primary">Where we work</span><h2 id="features_R_1jav5tep5b_-title" class="title-module-scss-module__Gmh66W__headline title-module-scss-module__Gmh66W__headlineSectionLarge">700 people, 5 offices, one shared system</h2><p class="title-module-scss-module__Gmh66W__subhead title-module-scss-module__Gmh66W__subheadSectionLarge">We build Airtable the same way our customers do — in it. Every team here plans, ships, and operates in the product, which is the fastest way to find out what's missing.</p></div></div></div><div data-orientation="horizontal" data-activation-direction="none" data-slot="tabs" class="tabs-module-scss-module__fbJ54G__root features-module-scss-module__8-XBpW__tabber"><div data-orientation="horizontal" data-activation-direction="none" role="tablist" data-slot="tabs-list" class="tabs-module-scss-module__fbJ54G__list features-module-scss-module__8-XBpW__tabberList"><button type="button" data-active="" data-orientation="horizontal" data-activation-direction="none" aria-disabled="false" tabindex="0" role="tab" aria-selected="true" id="base-ui-_R_5ljav5tep5b_" data-composite-item-active="" data-slot="tabs-trigger" class="tabs-module-scss-module__fbJ54G__trigger tabs-module-scss-module__fbJ54G__tabberButton features-module-scss-module__8-XBpW__tabberTrigger" aria-controls="base-ui-_R_6ljav5tep5b_"><span class="tabs-module-scss-module__fbJ54G__tabberButtonLabel">San Francisco HQ</span></button><button type="button" data-orientation="horizontal" data-activation-direction="none" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="base-ui-_R_9ljav5tep5b_" data-slot="tabs-trigger" class="tabs-module-scss-module__fbJ54G__trigger tabs-module-scss-module__fbJ54G__tabberButton features-module-scss-module__8-XBpW__tabberTrigger"><span class="tabs-module-scss-module__fbJ54G__tabberButtonLabel">Austin</span></button><button type="button" data-orientation="horizontal" data-activation-direction="none" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="base-ui-_R_dljav5tep5b_" data-slot="tabs-trigger" class="tabs-module-scss-module__fbJ54G__trigger tabs-module-scss-module__fbJ54G__tabberButton features-module-scss-module__8-XBpW__tabberTrigger"><span c