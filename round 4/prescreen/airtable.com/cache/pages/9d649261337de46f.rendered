fb41h93.js?dpl=dpl_FKofdzRLfURbLgDL5m9eTiefztPT\",\"/_next/static/chunks/351w6embc745g.js?dpl=dpl_FKofdzRLfURbLgDL5m9eTiefztPT\"],\"BlockRenderer\"]\n"])</script><script>self.__next_f.push([1,"2c:null\n34:[\"$\",\"$L3f\",null,{\"country\":\"IN\",\"enrolledAtRender\":false}]\n"])</script><script>self.__next_f.push([1,"20:[\"$\",\"main\",null,{\"data-marketing-template\":\"blocks\",\"className\":\"MarketingPageBlocks-module__7rSsmW__root font-body text-text-body w-full min-w-0 pb-16\",\"children\":[null,null,[[\"$\",\"div\",\"c1f0381f5b43\",{\"className\":\"w-full min-w-0\",\"children\":[\"$\",\"$L40\",null,{\"block\":{\"_key\":\"c1f0381f5b43\",\"_type\":\"contentStack\",\"backgroundMedia\":null,\"ctas\":[{\"_key\":\"6822a071bcdf\",\"_type\":\"cta\",\"buttonVariant\":\"primary\",\"href\":\"https://airtable.com/signup\",\"label\":\"Try Airtable\",\"linkType\":\"external\",\"openInNewTab\":false,\"pageSlug\":null,\"style\":\"button\",\"triggerAction\":false},{\"_key\":\"70ab1c7212d0\",\"_type\":\"cta\",\"buttonVariant\":\"secondary\",\"href\":\"https://airtable.com/careers\",\"label\":\"Join our team\",\"linkType\":\"external\",\"openInNewTab\":false,\"pageSlug\":null,\"style\":\"button\",\"triggerAction\":false}],\"headingGroup\":{\"eyebrow\":\"About Airtable\",\"heading\":\"Where ideas become infrastructure\",\"subheading\":[{\"_key\":\"4f0ae3468748\",\"_type\":\"block\",\"children\":[{\"_key\":\"1f0ad3f5e487\",\"_type\":\"span\",\"marks\":[],\"text\":\"In 2012, we started with a simple belief: the people who know the work should build the systems. As agents expand the definition of who — and what — can build, that belief holds today. In Airtable, what one person figures out becomes how the whole company operates.\"}],\"markDefs\":[],\"style\":\"normal\"}]},\"media\":null,\"sectionSettings\":{\"applyPaddingBottom\":null,\"applyPaddingTop\":null,\"sectionId\":null,\"sectionWidth\":null,\"theme\":null},\"theme\":null,\"themeExpanded\":null},\"pageContext\":{\"blockIndex\":0,\"pageSlug\":\"about\",\"pageTitle\":\"about - Page \u003e Common\"}}]}],[\"$\",\"div\",\"43a244400931\",{\"className\":\"w-full min-w-0\",\"children\":[\"$\",\"$L40\",null,{\"block\":{\"_key\":\"43a244400931\",\"_type\":\"bifold\",\"ctas\":null,\"headingGroup\":{\"eyebrow\":\"Our purpose\",\"heading\":\"To close the gap between “what if” and “it works”\",\"subheading\":[{\"_key\":\"70a6e11fcebd\",\"_type\":\"block\",\"children\":[{\"_key\":\"ba986c2bf99d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Rigidity, fragility, complexity, drudgery — four things that cost a company its best thinking. Airtable removes them. Teams model data to match how the business actually works, design workflows that improve instead of break, and hand agents the jobs nobody should be doing manually. All under the governance IT requires.\"}],\"markDefs\":[],\"style\":\"normal\"}]},\"imagePosition\":\"left\",\"media\":{\"_key\":\"0f29890491c9\",\"_type\":\"mediaComponent\",\"contentImage\":{\"_key\":\"ed36e94256f0\",\"_type\":\"contentImage\",\"alt\":\"What we do\",\"asset\":{\"_ref\":\"image-4180d9ccb12bbdab751818a7a116f7ceedce0330-1650x2062-webp\",\"_type\":\"reference\"},\"role\":\"functional\"},\"type\":\"image\"},\"sectionSettings\":{\"applyPaddingBottom\":null,\"applyPaddingTop\":null,\"sectionId\":null,\"sectionWidth\":null,\"theme\":null},\"theme\":null,\"themeExpanded\":null,\"variant\":\"inline\"},\"pageContext\":{\"blockIndex\":1,\"pageSlug\":\"about\",\"pageTitle\":\"about - Page \u003e Common\"}}]}],[\"$\",\"div\",\"e401a06daff9\",{\"className\":\"w-full min-w-0\",\"children\":[\"$\",\"$L40\",null,{\"block\":{\"_key\":\"e401a06daff9\",\"_type\":\"marquee\",\"cardType\":\"logo\",\"cta\":null,\"eyebrow\":\"Trusted by the world's largest organizations\",\"logoCards\":[{\"_key\":\"6d88dd492673\",\"_type\":\"logoCard\",\"cta\":{\"_type\":\"cta\",\"linkType\":\"none\",\"openInNewTab\":false,\"pageSlug\":null,\"style\":\"text\",\"triggerAction\":false},\"logo\":{\"_type\":\"conte